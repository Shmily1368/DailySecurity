{
  "$defs": {
    "Category": {
      "enum": [
        "vuln",
        "exploited",
        "research",
        "advisory",
        "threat-intel",
        "detection"
      ],
      "type": "string"
    },
    "ConfidenceLabel": {
      "enum": [
        "abstract_only",
        "metadata_only",
        "with_references",
        "full_text",
        "source_confirmed",
        "single_source",
        "multi_source",
        "unverified"
      ],
      "title": "ConfidenceLabel",
      "type": "string"
    },
    "DigestItem": {
      "additionalProperties": false,
      "properties": {
        "abstract_source": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract Source"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "cves": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "date_precision": {
          "default": "exact",
          "enum": [
            "exact",
            "year",
            "unknown"
          ],
          "title": "Date Precision",
          "type": "string"
        },
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "first_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen At"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "is_backfill": {
          "default": false,
          "title": "Is Backfill",
          "type": "boolean"
        },
        "llm_summary": {
          "$ref": "#/$defs/LlmSummary"
        },
        "products": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "published_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "published_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Year"
        },
        "rank_reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recommendation_score": {
          "minimum": 0,
          "type": "number"
        },
        "recommended_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_sources": {
          "items": {
            "$ref": "#/$defs/SourceInfo"
          },
          "title": "Related Sources",
          "type": "array"
        },
        "risk": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/RiskSignal"
            }
          ]
        },
        "risk_score": {
          "minimum": 0,
          "type": "number"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "shown_in_sections": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "type": "string"
        },
        "source_quality": {
          "default": "unknown",
          "enum": [
            "primary",
            "secondary",
            "community",
            "unknown"
          ],
          "title": "Source Quality",
          "type": "string"
        },
        "source_sub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sub"
        },
        "source_url": {
          "format": "uri",
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_status": {
          "default": "legacy",
          "enum": [
            "legacy",
            "model",
            "excerpt",
            "refused",
            "mock"
          ],
          "title": "Summary Status",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "paper",
            "cve",
            "kev",
            "advisory",
            "threat_report",
            "detection_rule"
          ],
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "vendors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "why_it_matters": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "title",
        "source",
        "source_name",
        "source_url",
        "published_at",
        "severity",
        "risk_score",
        "recommendation_score",
        "llm_summary",
        "why_it_matters",
        "confidence"
      ],
      "type": "object"
    },
    "ExploitMaturity": {
      "description": "Exploit 成熟度, 对齐 CVSS Temporal E (Exploit Code Maturity)。\n\n注意: 本字段只标注 \"存在性与成熟度\" 这一风险信号, 严禁在任何字段落地\nPoC 正文 / payload / 攻击步骤。",
      "enum": [
        "unreported",
        "poc",
        "functional",
        "weaponized",
        "in_the_wild"
      ],
      "title": "ExploitMaturity",
      "type": "string"
    },
    "ExploitRef": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "url",
        "source"
      ],
      "type": "object"
    },
    "Hero": {
      "additionalProperties": false,
      "properties": {
        "one_liner_zh": {
          "minLength": 1,
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/HeroStats"
        }
      },
      "required": [
        "one_liner_zh",
        "stats"
      ],
      "type": "object"
    },
    "HeroStats": {
      "additionalProperties": false,
      "properties": {
        "advisory_count": {
          "minimum": 0,
          "type": "integer"
        },
        "cve_count": {
          "minimum": 0,
          "type": "integer"
        },
        "kev_added": {
          "minimum": 0,
          "type": "integer"
        },
        "max_epss": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "paper_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ItemType": {
      "description": "条目类型, 覆盖论文与漏洞情报两大类。",
      "enum": [
        "paper",
        "cve",
        "kev",
        "advisory",
        "threat_report",
        "detection_rule"
      ],
      "title": "ItemType",
      "type": "string"
    },
    "KevStatus": {
      "description": "KEV 状态枚举, 比单纯布尔更明确。",
      "enum": [
        "listed",
        "not_listed",
        "unknown"
      ],
      "title": "KevStatus",
      "type": "string"
    },
    "LlmSummary": {
      "additionalProperties": false,
      "properties": {
        "actionability_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "affected_assets": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "affected_industries": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "affected_regions": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "attack_techniques": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "confidence_label": {
          "enum": [
            "source_confirmed",
            "abstract_only",
            "metadata_only",
            "with_references",
            "full_text",
            "single_source",
            "unverified",
            "multi_source",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "cves": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "defense_advice_zh": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "detection_signals_zh": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "impact_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "iocs_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "malware_families": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "novelty_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended_action_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "refusal": {
          "type": "boolean"
        },
        "refusal_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity_hint": {
          "$ref": "#/$defs/Severity"
        },
        "summary_zh": {
          "description": "中文摘要，目标 300~500 字；信息不足时可更短，不设影响历史数据的硬长度上限",
          "minLength": 1,
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "threat_actors": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "threat_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "why_it_matters_zh": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "summary_zh",
        "why_it_matters_zh",
        "novelty_score",
        "actionability_score",
        "confidence"
      ],
      "type": "object"
    },
    "RiskSignal": {
      "additionalProperties": false,
      "properties": {
        "cvss_score": {
          "maximum": 10,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "cvss_vector": {
          "type": [
            "string",
            "null"
          ]
        },
        "due_date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "epss_percentile": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "epss_score": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "exploit_in_the_wild": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exploit_maturity": {
          "default": "unreported",
          "enum": [
            "unreported",
            "poc",
            "functional",
            "weaponized",
            "in_the_wild"
          ],
          "type": "string"
        },
        "exploit_references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExploitRef"
          },
          "type": "array"
        },
        "has_public_exploit": {
          "default": false,
          "type": "boolean"
        },
        "kev_date_added": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "kev_listed": {
          "type": "boolean"
        },
        "kev_status": {
          "enum": [
            "listed",
            "not_listed",
            "unknown"
          ],
          "type": "string"
        },
        "known_exploited": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "known_ransomware": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "patch_references": {
          "items": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "type": "string"
          },
          "title": "Patch References",
          "type": "array"
        },
        "patch_status": {
          "default": "unknown",
          "enum": [
            "available",
            "unknown",
            "unavailable"
          ],
          "title": "Patch Status",
          "type": "string"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "type": "string"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "description": "数据来源描述。",
      "properties": {
        "link_kind": {
          "default": "article",
          "enum": [
            "article",
            "feed"
          ],
          "title": "Link Kind",
          "type": "string"
        },
        "native_id": {
          "description": "源站原始 ID",
          "title": "Native Id",
          "type": "string"
        },
        "source": {
          "description": "源枚举, 如 arxiv / nvd / kev / ghsa / vendor",
          "title": "Source",
          "type": "string"
        },
        "source_name": {
          "description": "人类可读来源名",
          "title": "Source Name",
          "type": "string"
        },
        "source_quality": {
          "default": "unknown",
          "enum": [
            "primary",
            "secondary",
            "community",
            "unknown"
          ],
          "title": "Source Quality",
          "type": "string"
        },
        "source_sub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "子来源, 如厂商名 / 会议名 / 博客名",
          "title": "Source Sub"
        },
        "source_url": {
          "description": "原始条目链接",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_name",
        "source_url",
        "native_id"
      ],
      "title": "SourceInfo",
      "type": "object"
    }
  },
  "$id": "https://cyber-daily-radar/schemas/digest_item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "前端消费的最终条目结构。外层 DailyDigest 包裹 items 数组。",
  "properties": {
    "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "health": {
      "additionalProperties": true,
      "title": "Health",
      "type": "object"
    },
    "hero": {
      "$ref": "#/$defs/Hero"
    },
    "is_mock": {
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/DigestItem"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "string"
    },
    "sections": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "date",
    "generated_at",
    "hero",
    "items"
  ],
  "title": "DigestItem",
  "type": "object"
}
