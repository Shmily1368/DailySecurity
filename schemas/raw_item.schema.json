{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://cyber-daily-radar/schemas/raw_item.schema.json",
    "title": "RawItem",
    "description": "所有 fetcher 归一化后的统一原始结构",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "type",
        "source_info",
        "title",
        "published_at",
        "fetched_at"
    ],
    "properties": {
        "id": {
            "type": "string",
            "description": "全局唯一 ID, 约定为 {source}:{native_id}",
            "minLength": 1
        },
        "type": {
            "type": "string",
            "enum": [
                "paper",
                "cve",
                "kev",
                "advisory",
                "threat_report",
                "detection_rule"
            ]
        },
        "source_info": {
            "$ref": "#/$defs/SourceInfo"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "summary": {
            "type": [
                "string",
                "null"
            ],
            "maxLength": 4000
        },
        "raw_text": {
            "type": [
                "string",
                "null"
            ]
        },
        "published_at": {
            "type": "string",
            "format": "date-time"
        },
        "updated_at": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "fetched_at": {
            "type": "string",
            "format": "date-time"
        },
        "authors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "affiliations": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "cves": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^CVE-\\d{4}-\\d{4,}$"
            }
        },
        "vendors": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "products": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "affected_versions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "topics": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "lang": {
            "type": "string",
            "default": "en"
        },
        "risk": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/RiskSignal"
                }
            ]
        },
        "references": {
            "type": "array",
            "items": {
                "type": "string",
                "format": "uri"
            }
        }
    },
    "$defs": {
        "SourceInfo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "source_name",
                "source_url",
                "native_id"
            ],
            "properties": {
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "source_sub": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_name": {
                    "type": "string",
                    "minLength": 1
                },
                "source_url": {
                    "type": "string",
                    "format": "uri"
                },
                "native_id": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "RiskSignal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cvss_score": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 10
                },
                "cvss_vector": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "epss_score": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                },
                "epss_percentile": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                },
                "kev_status": {
                    "type": "string",
                    "enum": [
                        "listed",
                        "not_listed",
                        "unknown"
                    ],
                    "default": "unknown"
                },
                "kev_listed": {
                    "type": "boolean",
                    "default": false
                },
                "kev_date_added": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "due_date": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "CISA KEV 强制修复截止日期"
                },
                "known_ransomware": {
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "known_exploited": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "是否已在野利用 (新契约字段)"
                },
                "exploit_in_the_wild": {
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "description": "兼容旧字段, 等价于 known_exploited"
                },
                "has_public_exploit": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否已存在公开 exploit / PoC (仅记录存在性)"
                },
                "exploit_maturity": {
                    "type": "string",
                    "enum": [
                        "unreported",
                        "poc",
                        "functional",
                        "weaponized",
                        "in_the_wild"
                    ],
                    "default": "unreported",
                    "description": "exploit 成熟度, 对齐 CVSS Temporal E"
                },
                "exploit_references": {
                    "type": "array",
                    "description": "仅存 URL + 元数据, 禁止落地 PoC 正文 / payload / 攻击步骤",
                    "items": {
                        "$ref": "#/$defs/ExploitRef"
                    },
                    "default": []
                }
            }
        },
        "ExploitRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url",
                "source"
            ],
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "source": {
                    "type": "string",
                    "minLength": 1,
                    "description": "来源标识 (exploit-db / github / vendor / cisa ...)"
                },
                "label": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        }
    }
}