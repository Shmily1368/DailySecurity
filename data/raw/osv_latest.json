      "id": "osv:CVE-2026-10666",
      "type": "advisory",
      "source_info": {
        "source": "osv",
        "source_sub": "osv.dev",
        "source_name": "OSV.dev",
        "source_url": "https://osv.dev/vulnerability/CVE-2026-10666",
        "native_id": "CVE-2026-10666"
