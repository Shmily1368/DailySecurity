    {
      "id": "osv:CVE-2026-113730",
      "type": "advisory",
      "source_info": {
        "source": "osv",
        "source_sub": "osv.dev",
        "source_name": "OSV.dev",
        "source_url": "https://osv.dev/vulnerability/CVE-2026-113730",
        "native_id": "CVE-2026-113730"
      },
      "title": "OGNL stricter-invocation block list bypass via java.lang.reflect reflection proxies",
      "summary": "OGNL is an Object Graph Navigation Library for Java. Prior to 3.4.13, the optional stricter-invocation mode in OgnlRuntime.invokeMethod checks the declaring class of the method that OGNL invokes but does not block java.lang.reflect.Method, java.lang.reflect.Constructor, or java.lang.reflect.Field. An attacker-controlled expression can invoke one of these reflection objects as a proxy for a method on a blocked class, causing the real operation to execute inside JDK reflection without passing through the stricter-invocation check again. Exploitation requires an application to evaluate untrusted OGNL expressions, use the default or an equivalently permissive MemberAccess that permits reflection, and rely on stricter invocation as a sandbox. Applications using a restrictive MemberAccess, including Apache Struts with SecurityMemberAccess, are not affected by this bypass. This issue is fixed in 3.4.13.",
      "raw_text": null,
      "published_at": "2026-10-20T21:24:24.093000Z",
      "updated_at": "2026-10-22T02:49:07.217080Z",
      "fetched_at": "2026-10-22T05:31:52.052600Z",
