":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-130754"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-130754","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T19:02:45.620000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/130xxx/CVE-2026-130754.json","https://github.com/laradashboard/laradashboard/security/advisories/GHSA-c5x3-wvxj-7cgr","https://nvd.nist.gov/vuln/detail/CVE-2026-130754"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":[],"patch_status":"unknown","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-130754","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-130754"},"summary":"All versions of LaraDashboard contain an authentication bypass in SocialAuthService::findOrCreateUser(), which links a social login to an existing account by email without checking that the OAuth provider verified that email. Unauthenticated attackers using an OAuth/OIDC provider that asserts a victim's email can log in as any user, including Superadmin, and keep persistent access through a linked social_accounts entry.","threat_meta":null,"title":"LaraDashboard Account Takeover via Unverified OAuth Email in SocialAuthService","topics":["advisory","cwe-287"],"type":"advisory","updated_at":"2026-11-21T05:45:46.758729Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-130750"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-130750","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T19:02:45.457000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/130xxx/CVE-2026-130750.json","https://github.com/Jovancoding/Network-AI/security/advisories/GHSA-jw52-p54c-w7hj","https://nvd.nist.gov/vuln/detail/CVE-2026-130750"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:N/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-130750"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-130750","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-130750"},"summary":"Network-AI from 5.11.0 before 5.17.2 contains a CORS misconfiguration in McpStreamableServer that reflects localhost Origins into Access-Control-Allow-Origin regardless of bind interface. Attackers controlling a localhost-origin page or DNS-rebinding name can read unauthenticated /tools and /health responses, exposing tool catalogs and bridge metadata on non-loopback binds.","threat_meta":null,"title":"Network-AI 5.11.0 before 5.17.2 CORS Misconfiguration via McpStreamableServer","topics":["advisory","cwe-346"],"type":"advisory","updated_at":"2026-11-21T05:46:04.967079Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-75521"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-75521","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T18:51:17.521000Z","published_year":null,"raw_text":null,"references":["https://github.com/mirendev/runtime/releases/tag/v0.11.1","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/75xxx/CVE-2026-75521.json","https://github.com/mirendev/runtime/security/advisories/GHSA-8fh7-7q4q-cq52","https://nvd.nist.gov/vuln/detail/CVE-2026-75521","https://github.com/mirendev/runtime/commit/e2159c8c8559da3f1c1485b463c794d656cd2fe4"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:H/SI:H/SA:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-75521"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-75521","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-75521"},"summary":"Miren Runtime provides the runtime component for the Miren application platform. Prior to 0.11.1, the QUIC/HTTP3 RPC server on the default port 8443 uses tls.RequestClientCert and does not verify that presented certificates chain to the configured cluster certificate authority. The RPC authenticators derive a caller identity from PeerCertificates[0].Subject.CommonName without requiring a non-empty VerifiedChains value, and certificate identities bypass all RBAC checks. A network attacker who can reach the listener can present a self-signed certificate with an issuer distinguished name matching the public cluster CA subject and gain cluster superuser access, allowing disclosure, modification, or disruption of applications, sandboxes, disks, credentials, and other managed resources. This issue is fixed in version 0.11.1.","threat_meta":null,"title":"Miren Runtime: Authentication bypass in RPC layer: unverified TLS client certificates grant cluster superuser access","topics":["advisory","cwe-295"],"type":"advisory","updated_at":"2026-11-21T05:45:52.764898Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-54747"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-54747","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T18:46:01.422000Z","published_year":null,"raw_text":null,"references":["https://github.com/chamilo/chamilo-lms/releases/tag/v2.0.3","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/54xxx/CVE-2026-54747.json","https://github.com/chamilo/chamilo-lms/security/advisories/GHSA-jv7g-9ff9-6cc5","https://nvd.nist.gov/vuln/detail/CVE-2026-54747","https://github.com/chamilo/chamilo-lms/commit/181687053b56f86654ac8f4ba0046fd3d97464c5"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:L/A:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-54747"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-54747","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-54747"},"summary":"Chamilo LMS is an open-source learning management system. Prior to 2.0.3, public/main/course_description/course_description_controller.php assigns contentDescription directly from a teacher's request in the Doctrine-based add and edit paths without cross-site scripting sanitization. The stored value is rendered by src/CoreBundle/Resources/views/Course/about.html.twig through description with raw output, and the /course/{id}/about route is publicly accessible. A teacher can store active content that executes when an authenticated or unauthenticated visitor views the course description, enabling session theft, credential phishing, defacement, or actions in an authenticated victim's session. This issue is fixed in version 2.0.3.","threat_meta":null,"title":"Chamilo LMS: Stored XSS in course description controller via contentDescription field","topics":["advisory","cwe-79"],"type":"advisory","updated_at":"2026-11-21T05:45:55.311996Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-61583"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-61583","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T18:22:30.461000Z","published_year":null,"raw_text":null,"references":["https://github.com/chamilo/chamilo-lms/releases/tag/v1.11.40","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/61xxx/CVE-2026-61583.json","https://github.com/chamilo/chamilo-lms/security/advisories/GHSA-853c-q5q4-jm2c","https://nvd.nist.gov/vuln/detail/CVE-2026-61583","https://github.com/chamilo/chamilo-lms/commit/84af54a6583cc85aa22c3ffa605476ef79348c21"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-61583"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-61583","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-61583"},"summary":"Chamilo LMS is an open-source learning management system. Prior to 1.11.40, main/dropbox/dropbox_functions.inc.php accepts a literal .htaccess filename in the course dropbox and stores it in a directory served by Apache, where the file can alter handler behavior under the required AllowOverride All configuration. Any authenticated course participant can upload .htaccess and then upload a PHP payload disguised as a .gif, resulting in code execution as the web-server user when the dropbox tool is enabled. This can expose or modify the Chamilo installation, course content, and database credentials. This issue is fixed in version 1.11.40.","threat_meta":null,"title":"Chamilo LMS: Authenticated RCE through .htaccess in dropbox","topics":["advisory","cwe-434"],"type":"advisory","updated_at":"2026-11-21T05:45:26.238532Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-45142"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-45142","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T18:16:07.453000Z","published_year":null,"raw_text":null,"references":["https://github.com/chamilo/chamilo-lms/releases/tag/v1.11.40","https://github.com/chamilo/chamilo-lms/releases/tag/v2.0.1","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/45xxx/CVE-2026-45142.json","https://github.com/chamilo/chamilo-lms/security/advisories/GHSA-wjxh-pvwh-h84p","https://nvd.nist.gov/vuln/detail/CVE-2026-45142","https://github.com/chamilo/chamilo-lms/commit/064787b28633b00218a6bf365248fdbf07b00e79","https://github.com/chamilo/chamilo-lms/commit/0b545d596ec83bb50d86e8f2e8de691e39ed9eab"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:L","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-45142"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-45142","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-45142"},"summary":"Chamilo LMS is an open-source learning management system. Prior to 1.11.40 and 2.0.1, main/lp/lp_ajax_save_objectives.php and public/main/lp/lp_ajax_save_objectives.php trust the request uid parameter instead of the authenticated user identity when saving SCORM learning objectives. Any authenticated student can replace uid with another user's identifier and overwrite that user's objectives because the endpoint performs no ownership check. This issue is fixed in versions 1.11.40 and 2.0.1.","threat_meta":null,"title":"Chamilo LMS: IDOR in lp_ajax_save_objectives.php — Attacker Can Overwrite Any User's SCORM Objectives via uid Parameter","topics":["advisory","cwe-639"],"type":"advisory","updated_at":"2026-11-21T05:45:26.487249Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-130007"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-130007","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T16:38:22.395000Z","published_year":null,"raw_text":null,"references":["https://github.com/reza-gholizade/k8s-mcp-server/releases/tag/v1.1.0","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/130xxx/CVE-2026-130007.json","https://github.com/reza-gholizade/k8s-mcp-server/security/advisories/GHSA-m932-63jc-4jqq","https://nvd.nist.gov/vuln/detail/CVE-2026-130007","https://github.com/reza-gholizade/k8s-mcp-server/issues/131","https://github.com/reza-gholizade/k8s-mcp-server/commit/817d81005369837e0c034962785851ca4dec9a76","https://github.com/reza-gholizade/k8s-mcp-server/pull/134"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:N/SC:H/SI:H/SA:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-130007"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-130007","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-130007"},"summary":"k8s-mcp-server manages Kubernetes clusters through the Model Context Protocol. Prior to 1.1.0, SERVER_MODE defaults to SSE, with the listener on 0.0.0.0:8080, but main.go creates the SSE server without an authentication option or context function. The GET /sse handler creates a sessionId that is only a correlation value, and the POST /message handler accepts a loadable sessionId without an authorization or Origin check before dispatching tools/call; consequently, any client able to reach the port can enumerate and invoke registered Kubernetes tools without credentials. Read-only mode is disabled by default, leaving write-capable Kubernetes tools available to run with the server's configured cluster privileges. This issue is fixed in version 1.1.0.","threat_meta":null,"title":"k8s-mcp-server: Missing authentication on default SSE/HTTP transport allows unauthenticated Kubernetes tool execution","topics":["advisory","cwe-306"],"type":"advisory","updated_at":"2026-11-21T05:45:42.474464Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-48728"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-48728","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-18T15:53:03.813000Z","published_year":null,"raw_text":null,"references":["https://github.com/glpi-project/glpi-inventory-plugin/releases/tag/1.6.8","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/48xxx/CVE-2026-48728.json","https://github.com/glpi-project/glpi-inventory-plugin/security/advisories/GHSA-xj72-9f7x-f4hm","https://nvd.nist.gov/vuln/detail/CVE-2026-48728","https://github.com/glpi-project/glpi-inventory-plugin/commit/1dece10213ad5e8d1a548cc474466a2368bb82cb"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:L/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-48728"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-48728","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-48728"},"summary":"The GLPI Inventory Plugin handles network discovery, inventory, software deployment, and data collection for GLPI agents. Prior to 1.6.8, the /b/deploy, /b/collect, and /b/esx agent API endpoints do not authenticate requests before processing Deploy, Collect, and ESX task operations. An unauthenticated remote attacker can enumerate jobs and manipulate their status through these endpoints, disclosing job information and interfering with task processing. This issue is fixed in version 1.6.8.","threat_meta":null,"title":"GLPI Inventory Plugin : Job enumeration and status manipulation on Deploy, Collect, and ESX agent API endpoints","topics":["advisory","cwe-306"],"type":"advisory","updated_at":"2026-11-21T05:45:44.919894Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-129448"],"date_precision":"exact","fetched_at":"2026-11-21T06:56:14.259466Z","first_seen_at":"2026-11-21T06:56:14.259466Z","id":"osv:CVE-2026-129448","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-17T11:03:49.685000Z","published_year":null,"raw_text":null,"references":["https://www.cisa.gov/known-exploited-vulnerabilities-catalog?field_cve=CVE-2026-129448","https://www.cve.org/CVERecord?id=CVE-2026-82384","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/129xxx/CVE-2026-129448.json","https://lists.apache.org/thread.html/lnz4s26tv6hdo03wngtdbpfj4hg4gtds","https://lists.apache.org/thread/cc0jck13nb9vvcmzxzwotr6n16mx28z9","https://nvd.nist.gov/vuln/detail/CVE-2026-129448","https://github.com/apache/roller/pull/171","https://gitbox.apache.org/repos/asf/roller.git"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-129448"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-129448","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-129448"},"summary":"Deserialization of Untrusted Data in Apache Roller versions 4.0.0 through 6.1.4 allows an unauthenticated remote attacker to execute arbitrary code. The XML-RPC endpoint accepts vendor extension types and deserializes them before authenticating the requester.\n\nThis is the same vulnerability as CVE-2026-82384, which listed only Apache Roller 6.1.5 as affected. This issue is being actively exploited.\n\nUsers are recommended to upgrade to Apache Roller 6.1.6 or later, which disables the extension types and rejects XML-RPC requests when the XML-RPC feature is disabled.\n\nUsers who cannot upgrade right away should set \"enabledForExtensions\" to \"false\" in WEB-INF/web.xml, or remove the \"/roller-services/xmlrpc\" servlet mapping, and restart Roller. Disabling XML-RPC in the administration UI is not enough, because older versions deserialize the request before checking that setting.","threat_meta":null,"title":"Apache Roller: Unauthenticated deserialization in the XML-RPC endpoint (releases before 6.1.5)","topics":["advisory","cwe-502"],"type":"advisory","updated_at":"2026-11-21T05:45:42.778878Z","vendors":[]}],"meta":{"cve_inputs":["CVE-2026-133471","CVE-2026-133439","CVE-2026-132781","CVE-2026-132089","CVE-2026-132082","CVE-2026-132081","CVE-2026-132073","CVE-2026-132044","CVE-2026-132042","CVE-2026-131985","CVE-2026-131984","CVE-2026-131983","CVE-2026-131979","CVE-2026-131978","CVE-2026-131977","CVE-2026-131976","CVE-2026-131975","CVE-2026-131971","CVE-2026-130894","CVE-2026-130892","CVE-2026-130891","CVE-2026-127002","CVE-2026-126039","CVE-2026-125932","CVE-2026-123663","CVE-2026-121155","CVE-2026-121154","CVE-2026-121153","CVE-2026-121152","CVE-2026-121151","CVE-2026-121150","CVE-2026-120539","CVE-2026-119607","CVE-2026-119184","CVE-2026-115226","CVE-2026-114436","CVE-2026-114435","CVE-2026-114434","CVE-2026-111975","CVE-2026-111067","CVE-2026-76466","CVE-2026-75521","CVE-2026-61583","CVE-2026