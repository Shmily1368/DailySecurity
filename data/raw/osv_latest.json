etched_at":"2026-11-14T06:07:30.888168Z","first_seen_at":"2026-11-14T06:07:30.888168Z","id":"osv:CVE-2026-64686","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-11T04:10:36.576000Z","published_year":null,"raw_text":null,"references":["https://github.com/opensearch-project/OpenSearch-Dashboards/releases/tag/2.19.6","https://github.com/opensearch-project/OpenSearch-Dashboards/releases/tag/3.7.0","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/64xxx/CVE-2026-64686.json","https://github.com/opensearch-project/OpenSearch-Dashboards/security/advisories/GHSA-6qp6-3675-ffr3","https://nvd.nist.gov/vuln/detail/CVE-2026-64686"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:L/I:N/A:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-64686"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-64686","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-64686"},"summary":"OpenSearch Dashboards is an open-source data visualization tool designed to work with OpenSearch. From versions 2.14.0 to before 2.19.6, and 3.0.0 to before 3.7.0, a Server-Side Request Forgery (SSRF) vulnerability in OpenSearch Dashboards exists in the fetchDataSourceMetaData route. The sibling test_connection route validates incoming endpoint URLs via isValidURL() against configured endpointDeniedIPs and endpointAllowlistedSuffixes lists, but fetchDataSourceMetaData accepts the same input shape without performing this validation. An authenticated user can supply an internal or loopback endpoint to probe internal network resources. This issue has been patched in versions 2.19.6 and 3.7.0.","threat_meta":null,"title":"OpenSearch Dashboards: SSRF in fetchDataSourceMetaData — missing endpoint validation","topics":["advisory","cwe-918"],"type":"advisory","updated_at":"2026-11-14T02:30:27.207458Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-64669"],"date_precision":"exact","fetched_at":"2026-11-14T06:07:30.888168Z","first_seen_at":"2026-11-14T06:07:30.888168Z","id":"osv:CVE-2026-64669","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-11T03:52:43.930000Z","published_year":null,"raw_text":null,"references":["https://github.com/mcdope/pam_usb/releases/tag/0.9.3","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/64xxx/CVE-2026-64669.json","https://github.com/mcdope/pam_usb/security/advisories/GHSA-gc4c-v52c-2v34","https://nvd.nist.gov/vuln/detail/CVE-2026-64669","https://github.com/mcdope/pam_usb/commit/a62513f3da871d6576d751de3482eb80b9ac79f3","https://github.com/mcdope/pam_usb/pull/423"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-64669"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-64669","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-64669"},"summary":"pam_usb provides hardware authentication for Linux using removable media. From version 0.8.0 to before version 0.9.3, the deny_remote feature in pam_usb uses /usr/bin/w -i to detect whether the authenticating user has an active remote tmux session. In pusb_tmux_has_remote_clients() (src/tmux.c), the IPv6 detection regex required exactly four explicit colon-separated groups of 1-4 hex digits (e.g. 2001:0db8:85a3:0000). Any IPv6 address in compressed notation — including loopback (::1), link-local (fe80::1), and global unicast addresses (2001:db8::1) — did not match this pattern. As a result the remote-client check silently returned \"no remote clients\" even when a remote tmux client was connected from such an address. This issue has been patched in version 0.9.3.","threat_meta":null,"title":"pam_usb: deny_remote bypassed by compressed IPv6 addresses in pusb_tmux_has_remote_clients","topics":["advisory","cwe-285","cwe-693"],"type":"advisory","updated_at":"2026-11-14T02:47:37.159511Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-64671"],"date_precision":"exact","fetched_at":"2026-11-14T06:07:30.888168Z","first_seen_at":"2026-11-14T06:07:30.888168Z","id":"osv:CVE-2026-64671","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-11T03:42:13.103000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/64xxx/CVE-2026-64671.json","https://github.com/walinejs/waline/security/advisories/GHSA-7w94-hxwm-gg99","https://nvd.nist.gov/vuln/detail/CVE-2026-64671"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":[],"patch_status":"unknown","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-64671","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-64671"},"summary":"Waline is a comment system with backend support. In versions 3.15.2 and prior, the @waline/client UserList widget builds its DOM by concatenating server-returned commenter fields directly into root.innerHTML with no HTML escaping. The commenter nick and link are stored and returned verbatim by the server (only the comment body is sanitized), and the link field is never sent to the spam filter. So an unauthenticated visitor who posts a comment with link = x\"><img src=x onerror=...> achieves stored cross-site scripting that executes, with no interaction, in the browser of every visitor to a page that embeds the UserList widget. At time of publication, there are no publicly available patches.","threat_meta":null,"title":"Stored XSS in the @waline/client UserList widget via an unescaped commenter link field","topics":["advisory","cwe-116","cwe-79"],"type":"advisory","updated_at":"2026-11-14T02:31:03.246493Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-126571"],"date_precision":"exact","fetched_at":"2026-11-14T06:07:30.888168Z","first_seen_at":"2026-11-14T06:07:30.888168Z","id":"osv:CVE-2026-126571","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-11T02:36:06.963000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/126xxx/CVE-2026-126571.json","https://github.com/padloc/padloc/security/advisories/GHSA-3mq5-m2qg-fqhq","https://nvd.nist.gov/vuln/detail/CVE-2026-126571","https://www.vulncheck.com/advisories/padloc-4.0.0-before-4.3.1-email-mfa-code-brute-force-via-retrievemfatoken","https://github.com/padloc/padloc/commit/26f292515fe623826070454872f9cee08b756544","https://github.com/padloc/padloc","https://github.com/padloc/padloc/blob/v4.3.0/packages/core/src/v3-compat.ts#L191-L210"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-126571"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-126571","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-126571"},"summary":"Padloc 4.0.0 before 4.3.1 contains an authentication bypass vulnerability in the legacy retrieveMFAToken handler that never counts wrong email verification codes toward the attempt limit. Unauthenticated attackers knowing a victim's email can brute force the 6-digit code to obtain verification tokens usable in signup, login and account recovery flows.","threat_meta":null,"title":"Padloc 4.0.0 before 4.3.1 Email MFA Code Brute Force via retrieveMFAToken","topics":["advisory","cwe-307"],"type":"advisory","updated_at":"2026-11-14T02:30:57.599533Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-126566"],"date_precision":"exact","fetched_at":"2026-11-14T06:07:30.888168Z","first_seen_at":"2026-11-14T06:07:30.888168Z","id":"osv:CVE-2026-126566","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-11T02:36:04.046000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/126xxx/CVE-2026-126566.json","https://github.com/SemanticMediaWiki/SemanticMediaWiki/releases/tag/7.4.1","https://github.com/SemanticMediaWiki/SemanticMediaWiki/security/advisories/GHSA-gh59-2vh3-6cgm","https://nvd.nist.gov/vuln/detail/CVE-2026-126566","https://www.vulncheck.com/advisories/semantic-mediawiki-7.3.1-before-7.4.1-incorrect-authorization-vi