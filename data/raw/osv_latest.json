{"items":[{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-88811"],"date_precision":"exact","fetched_at":"2026-11-03T06:33:46.823732Z","first_seen_at":"2026-11-03T06:33:46.823732Z","id":"osv:CVE-2026-88811","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-02T16:48:44.799000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/88xxx/CVE-2026-88811.json","https://github.com/rancher/rancher/","https://github.com/rancher/rancher/security/advisories/GHSA-x82x-2qj6-5rm2","https://nvd.nist.gov/vuln/detail/CVE-2026-88811"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-88811"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-88811","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-88811"},"summary":"Missing filtering in the SUSE Rancher Manager meta proxy could cause passed in rancher credentials to be leaked to cloud providers. This affects SUSE Rancher 2.15.0 up to 2.15.3, 2.14.0 up to 2.14.7, 2.13.0 up to 2.13.11,","threat_meta":null,"title":"Rancher credentials disclosed to third-party hosts by the Rancher Manager meta proxy","topics":["advisory","cwe-201"],"type":"advisory","updated_at":"2026-11-03T02:47:34.319999Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-88810"],"date_precision":"exact","fetched_at":"2026-11-03T06:33:46.823732Z","first_seen_at":"2026-11-03T06:33:46.823732Z","id":"osv:CVE-2026-88810","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-02T16:29:46.733000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/88xxx/CVE-2026-88810.json","https://github.com/rancher/rancher/","https://github.com/rancher/webhook/","https://github.com/rancher/webhook/security/advisories/GHSA-f898-2c8h-r7jc","https://nvd.nist.gov/vuln/detail/CVE-2026-88810"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:H/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-88810"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-88810","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-88810"},"summary":"A privilege escalation issue was discovered in Rancher Manager's role-based access control. The inheritedNamespacedRules field of a GlobalRole propagates permissions into named namespaces of every downstream cluster managed by the Rancher instance, but it was not subject to the privilege-escalation validation applied to the other permission-carrying fields of a GlobalRole. As a result, a non-administrative user could be granted, through a global role  binding, permissions in downstream clusters that exceed the permissions that user already holds. This affected SUSE Rancher 2.15.2 only, and SUSE Rancher Webhook 0.11.0 up to 0.11.4, and 0.12.0 up to 0.12.1.","threat_meta":null,"title":"Privilege escalation in downstream clusters via GlobalRole inheritedNamespacedRules","topics":["advisory","cwe-306"],"type":"advisory","updated_at":"2026-11-03T02:47:34.418436Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-94290"],"date_precision":"exact","fetched_at":"2026-11-03T06:33:46.823732Z","first_seen_at":"2026-11-03T06:33:46.823732Z","id":"osv:CVE-2026-94290","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-02T15:29:41.052000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/94xxx/CVE-2026-94290.json","https://github.com/rancher/fleet","https://github.com/rancher/fleet/security/advisories/GHSA-qfmw-gw96-ffcr","https://nvd.nist.gov/vuln/detail/CVE-2026-94290"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:C/C:H/I:H/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-94290"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-94290","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-94290"},"summary":"SUSE Rancher Fleet clusters reference a kubeconfig secret that the controller uses to install and manage a Fleet agent on the target cluster. The controller did not sufficiently restrict which kubeconfig secrets a Fleet Cluster object was allowed to reference. As a result, a Fleet cluster defined in a namespace an ordinary user controls could be associated with administrative credentials for the management cluster itself, causing the controller to manage the management cluster on that user's behalf and to run that user's Fleet content there with elevated privileges. This affects SUSE Rancher Fleet 0.16.0 up to 0.16.3, 0.15.0 up to 0.15.8, 0.14.0 up to 0.14.12, 0.13.0 up to 0.13.17 and possible older versions.","threat_meta":null,"title":"Privilege escalation to cluster-admin on the Rancher local cluster through Fleet's agent management controller","topics":["advisory","cwe-250"],"type":"advisory","updated_at":"2026-11-03T02:47:28.848906Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2025-9566"],"date_precision":"exact","fetched_at":"2026-11-03T06:33:46.823732Z","first_seen_at":"2026-11-03T06:33:46.823732Z","id":"osv:CVE-2025-9566","is_backfill":false,"lang":"en","products":[],"published_at":"2025-09-05T19:54:30.503000Z","published_year":null,"raw_text":null,"references":["https://access.redhat.com/downloads/content/package-browser/","https://catalog.redhat.com/software/containers/","https://access.redhat.com/errata/RHBA-2025:15692","https://access.redhat.com/errata/RHBA-2025:15712","https://access.redhat.com/errata/RHBA-2025:16158","https://access.redhat.com/errata/RHBA-2025:16163","https://access.redhat.com/errata/RHEA-2025:4782","https://access.redhat.com/errata/RHSA-2025:15900","https://access.redhat.com/errata/RHSA-2025:15901","https://access.redhat.com/errata/RHSA-2025:15904","https://access.redhat.com/errata/RHSA-2025:16480","https://access.redhat.com/errata/RHSA-2025:16481","https://access.redhat.com/errata/RHSA-2025:16482","https://access.redhat.com/errata/RHSA-2025:16488","https://access.redhat.com/errata/RHSA-2025:16515","https://access.redhat.com/errata/RHSA-2025:16724","https://access.redhat.com/errata/RHSA-2025:17669","https://access.redhat.com/errata/RHSA-2025:18217","https://access.redhat.com/errata/RHSA-2025:18218","https://access.redhat.com/errata/RHSA-2025:18240"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploi