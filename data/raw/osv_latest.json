s://github.com/xiaochong0302/course-tencent-cloud/blob/v2.0.1/app/Http/Home/Controllers/RefundController.php#L49-L64","https://github.com/xiaochong0302/course-tencent-cloud/commit/8e8bcb4e13795006e16d51158790ce3120c8164a","https://github.com/xiaochong0302/course-tencent-cloud/issues/38","https://hackmd.io/@hieund/course-tencent-cloud-refund-confirm-missing-owner-check-idor","https://nvd.nist.gov/vuln/detail/CVE-2026-129469","https://www.vulncheck.com/advisories/course-tencent-cloud-before-2.0.2-idor-via-api-refund-confirm"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-129469"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-129469","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-129469"},"summary":"Course-tencent-cloud before 2.0.2 contains an insecure direct object reference vulnerability that allows unauthenticated attackers to view other users' refund previews by supplying an order sn to /api/refund/confirm. Attackers can compute valid sn values from Sqids-encoded sequential order ids using the default key to disclose ordered items, prices, refund amounts, fees and deadlines.","threat_meta":null,"title":"Course-tencent-cloud before 2.0.2 IDOR via /api/refund/confirm","topics":["advisory","cwe-639"],"type":"advisory","updated_at":"2026-11-16T02:45:11.745689Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-129456"],"date_precision":"exact","fetched_at":"2026-11-16T03:10:02.212631Z","first_seen_at":"2026-11-16T03:10:02.212631Z","id":"osv:CVE-2026-129456","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-14T19:13:23.983000Z","published_year":null,"raw_text":null,"references":["https://github.com/FRRouting/frr/","https://github.com/FRRouting/frr/pull/21176/changes/1238ac4a06e5c23595e8bf626856f297d0c302a2","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/129xxx/CVE-2026-129456.json","https://nvd.nist.gov/vuln/detail/CVE-2026-129456","https://github.com/FRRouting/frr/issues/20874","https://github.com/FRRouting/frr/commit/5c241056777b27b209bc89326f0061ec6d5e0924","https://github.com/FRRouting/frr/commit/abef07b500e19baa924d157ab03809b93730e619","https://github.com/FRRouting/frr/commit/bebf95f02bc0dccc6a1841f0c8cbcba1f617d655","https://github.com/FRRouting/frr/pull/22008/changes/40f25e62686865649b7631ec30756f9661e12dd3"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:L/AU:N/R:A","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-129456"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-129456","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-129456"},"summary":"In FRRouting, bgpd frees the sub-TLV chain of a Tunnel Encapsulation attribute (type 23) while routes stored by bgpd still point to it, if the attribute is received from a neighbor that has \"soft-reconfiguration inbound\" configured. A cache added to speed up attribute interning while processing the prefixes of an UPDATE checks whether an interned attribute set may be reused by comparing the parsed attributes with themselves, so the check always succeeds. Interning the parsed attributes for the Adj-RIB-In removes the Tunnel Encapsulation sub-TLVs from them, and the copy that bgpd then interns for the route reuses the cached attribute set, which still holds the sub-TLVs, without taking a reference on them. When the route is later replaced, withdrawn or cleared, for example when the session goes down, the sub-TLV chain is freed while still in use, and bgpd then reads it, decrements a reference count inside it and frees it a second time. In the reporter's build without AddressSanitizer this ended in an assertion failure in bgpd's memory accounting, aborting bgpd and dropping all BGP sessions on the router, and the neighbor can repeat it each time bgpd restarts. Because freed heap memory is written to and freed again, consequences beyond a crash cannot be ruled out. An established BGP session is required, and the attribute does not need to be malformed. bgpd processes attribute 23 from every neighbor, including eBGP neighbors, unless it is explicitly discarded, although RFC 9012 requires it to be filtered on eBGP sessions by default. Neighbors without \"soft-reconfiguration inbound\" are not affected.","threat_meta":null,"title":"frr: bgpd use-after-free of Tunnel Encapsulation sub-TLVs via the attribute intern reuse cache with soft-reconfiguration inbound","topics":["advisory","cwe-415","cwe-416"],"type":"advisory","updated_at":"2026-11-16T02:45:16.147528Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-71519"],"date_precision":"exact","fetched_at":"2026-11-16T03:10:02.212631Z","first_seen_at":"2026-11-16T03:10:02.212631Z","id":"osv:CVE-2026-71519","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-13T22:33:25.305000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/71xxx/CVE-2026-71519.json","https://github.com/PrestaShop/PrestaShop/security/advisories/GHSA-hjwq-7qvv-qxj4","https://nvd.nist.gov/vuln/detail/CVE-2026-71519","https://www.vulncheck.com/advisories/prestashop-webservice-api-authorization-bypass-via-id-shop-parameter","https://github.com/PrestaShop/PrestaShop/releases/tag/8.2.9","https://github.com/PrestaShop/PrestaShop/releases/tag/9.2.1","https://github.com/PrestaShop/PrestaShop"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-71519"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-71519","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-71519"},"summary":"PrestaShop before 8.2.9 and 9.2.1 contains a broken access control vulnerability that allows an authenticated Webservice API key holder to read and modify customer records belonging to any shop in a multi-shop installation. Attackers can exploit the missing record-level shop ownership check in shopHasRight() and saveEntityFromXml() to read sensitive customer data such as password hashes and secure keys, and change a customer's email and password via create, update, and delete requests, resulting in account takeover.","threat_meta":null,"title":"PrestaShop Webservice API Broken Access Control via Customer Endpoint","topics":["advisory","cwe-639"],"type":"advisory","updated_at":"2026-11-16T02:45:31.998646Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-71531"],"date_precision":"exact","fetched_at":"2026-11-16T03:10:02.212631Z","first_seen_at":"2026-11-16T03:10:02.212631Z","id":"osv:CVE-2026-71531","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-13T22:32:06.723000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/71xxx/CVE-2026-71531.json","https://github.com/PrestaShop/PrestaShop/security/advisories/GHSA-3f36-4qv4-vfgh","https://nvd.nist.gov/vuln/detail/CVE-2026-71531","https://www.vulncheck.com/advisories/prestashop-webservice-api-authorization-bypass-via-id-shop-parameter","https://github.com/PrestaShop/PrestaShop/releases/tag/8.2.9","https://github.com/PrestaShop/PrestaShop/releases/tag/9.2.1","https://github.com/PrestaShop/PrestaShop"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:N/SC:N/SI:N/SA:N","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-71531"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-71531","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-71531"},"summary":"PrestaShop before 8.2.9 and 9.2.1 contains an authorization flaw in the Webservice API that allows an attacker holding a key restricted to one shop to act on data of every shop by submitting requests with id_shop=all or id_shop_group=N, which expand the shop context without validating the key's actual shop associations and cause shopHasRight() to evaluate the expanded set as a disjunction. Attackers can exploit this flaw via classes/webservice/WebserviceRequest.php to read, modify, or delete data belonging to shops they are not authorized for, including full customer records such as email addresses, secure_key, and password hashes across the installation.","threat_meta":null,"title":"PrestaShop Webservice API Authorization Bypass via id_shop Parameter","topics":["advisory","cwe-863"],"type":"advisory","updated_at":"2026-11-16T02:45:32.075430Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-99288"],"date_precision":"exact","fetched_at":"2026-11-16T03:10:02.212631Z","first_seen_at":"2026-11-16T03:10:02.212631Z","id":"osv:CVE-2026-99288","is_backfill":false,"lang":"en","products":["Kernel"],"published_at":"2026-11-10T18:19:08.557000Z","published_year":null,"raw_text":null,"references":["https://git.kernel.org/stable/c/4e2b3ef19e0e04adca38442f07dd6bc93c712bf1","https://git.kernel.org/stable/c/8e5172cbd227fae32f3313cba1f3e1b9edb5c4fd","https://git.kernel.org/stable/c/d69100340b4cae08d40f898f1b601032403f6be6","https://git.kernel.org/stable/c/eb8a2d156f2c1d862fffdfd1b3432bfbcd939879","https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/99xxx/CVE-2026-99288.json","https://nvd.nist.gov/vuln/detail/CVE-2026-99288","https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"],"risk":{"cvss_score":null,"cvss_vector":null,"due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-99288"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-99288","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-99288"},"summary":"In the Linux kernel, the following vulnerability has been resolved:\n\ninet: reject unhashed sockets during established lookups\n\nTCP established ehash lookups are lockless. The socket caches involved\nuse SLAB_TYPESAFE_BY_RCU, so memory can be reused before an RCU reader\nthat retained its old address has finished.\n\nAfter a tuple match, __inet_lookup_established() and\n__inet6_lookup_established() acquire a reference and repeat the tuple\ncheck. They do not check whether the new object is hashed. If the\naddress is reused for a socket with the same tuple, the lookup can\nacquire a reference to the new object and return it while its nulls node\nis unhashed.\n\nA PoC that drives reuse with a SYN cookie request socket reproduced the\ncrash. The new request socket is unhashed and has a NULL rsk_listener.\nA lookup that had loaded the address of the old request socket acquired\nthe reference published by tcp_get_cookie_sock() and returned the new\nobject. tcp_v4_rcv() then read sk_state through the NULL listener.\n\nThe resulting crash was:\n\n  BUG: kernel NULL pointer dereference, address: 0000000000000012\n  #PF: supervisor read access in kernel mode\n  #PF: error_code(0x0000) - not-present page\n  ...\n  Oops: Oops: 0000 [#1] SMP NOPTI\n  CPU: 4 UID: 0 PID: 0 Comm: swapper/4 Not tainted 7.3.0-00591-g0e135910deec #1 PREEMPT(lazy)\n  ...\n  RIP: 0010:tcp_v4_rcv+0x44e/0x1280\n  ...\n  R10: 0000000000000001 R11: 00000000024ca8c0 R12: 0000000000000000\n  ...\n  CR2: 0000000000000012 CR3: 0000000103d50004 CR4: 0000000000770ef0\n  ...\n  Call Trace:\n   <IRQ>\n   ? raw_local_deliver+0xae/0x240\n   ip_protocol_deliver_rcu+0x2d/0x180\n   ip_local_deliver_finish+0x84/0x100\n   ip_sublist_rcv_finish+0x5f/0x70\n   ip_sublist_rcv+0x12a/0x1d0\n   ip_list_rcv+0xfd/0x130\n   __netif_receive_skb_list_core+0x223/0x250\n   netif_receive_skb_list_internal+0x1d2/0x2c0\n   ? try_fill_recv+0x39/0x7b0\n   napi_complete_done+0x74/0x170\n   virtnet_poll+0x445/0x600\n   __napi_poll+0x27/0x1e0\n   net_rx_action+0x2fe/0x3b0\n   handle_softirqs+0xc2/0x2c0\n   __irq_exit_rcu+0x74/0xd0\n   common_interrupt+0x7f/0x90\n   </IRQ>\n  ...\n  Kernel panic - not syncing: Fatal exception in interrupt\n\nAfter taking a reference, check whether the nulls node is unhashed in\nboth IPv4 and IPv6 established lookups. If it is unhashed or the tuple\nno longer matches, drop the reference and restart the lookup.\n\nLookups racing with the TIME_WAIT hashdance, or with a request being\nreplaced by its child, now restart and find the new socket instead of\nreturning the old one.\n\nRequest sockets that were never inserted into ehash can have a nonzero\nrefcount, and a stale lookup can hold a transient reference. Therefore,\nwhen SYN cookie, Fast Open, and request migration paths fail after\nsetting a nonzero refcount, release the references held by those paths\nwith reqsk_put() instead of freeing the request directly.","threat_meta":null,"title":"inet: reject unhashed sockets during established lookups","topics":["advisory","linux"],"type":"advisory","updated_at":"2026-11-15T02:31:06.037915Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2026-124684"],"date_precision":"exact","fetched_at":"2026-11-16T03:10:02.212631Z","first_seen_at":"2026-11-16T03:10:02.212631Z","id":"osv:CVE-2026-124684","is_backfill":false,"lang":"en","products":[],"published_at":"2026-11-09T11:28:07.068000Z","published_year":null,"raw_text":null,"references":["https://github.com/CVEProject/cvelistV5/tree/main/cves/2026/124xxx/CVE-2026-124684.json","https://nvd.nist.gov/vuln/detail/CVE-2026-124684","https://github.com/Samsung/escargot/commit/8bc35b7b88f0f96c66a42aa965a1a710308b61d5"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:L/AC:H/PR:N/UI:N/S:U/C:N/I:N/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":["https://osv.dev/vulnerability/CVE-2026-124684"],"patch_status":"available","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2026-124684","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2026-124684"},"summary":"This issue can cause a heap-use-after-free when an embedder unloads a ReloadableString buffer while a previously returned raw character pointer remains in use. Successful triggering may cause the Escargot-based process to crash, resulting in a denial of service.","threat_meta":null,"title":"CVE-2026-124684","topics":["advisory","cwe-416"],"type":"advisory","updated_at":"2026-11-14T07:14:43.756674Z","vendors":[]}],"meta":{"cve_inputs":["CVE-2026-129543","CVE-2026-129542","CVE-2026-129541","CVE-2026-129540","CVE-2026-129539","CVE-2026-99288","CVE-2026-129494","CVE-2026-129493","CVE-2026-129492","CVE-2026-129491","CVE-2026-71531","CVE-2026-71519","CVE-2026-129525","CVE-2026-129341","CVE-2026-129337","CVE-2026-128365","CVE-2026-128359","CVE-2026-127958","CVE-2026-126338","CVE-2026-125617","CVE-2026-123642","CVE-2026-123638","CVE-2026-123065","CVE-2026-123009","CVE-2026-123002","CVE-2026-120991","CVE-2026-120729","CVE-2026-120725","CVE-2026-118535","CVE-2026-118389","CVE-2026-125423","CVE-2026-123006","CVE-2026-73186","CVE-2026-57739","CVE-2026-129091","CVE-2026-125830","CVE-2026-125826","CVE-2026-125823","CVE-2026-125822","CVE-2026-125818","CVE-2026-125817","CVE-2026-125804","CVE-2026-125798","CVE-2026-125796","CVE-2026-125760","CVE-2026-123962","CVE-2026-129456","CVE-2026-129490","CVE-2026-129485","CVE-2026-129484","CVE-2025-71470","CVE-2025-71469","CVE-2025-71468","CVE-2025-71467","CVE-2025-71466","CVE-2026-128893","CVE-2026-125799","CVE-2026-125795","CVE-2026-125793","CVE-2026-125771","CVE-2026-125765","CVE-2026-125733","CVE-2026-125447","CVE-2026-129483","CVE-2026-129482","CVE-2026-129480","CVE-2026-129479","CVE-2026-1294