credentials or other authentication mechanisms.","threat_meta":null,"title":"Kernel: ksmbd brute force delay bypass via asynchronous requests","topics":["advisory","cwe-307"],"type":"advisory","updated_at":"2026-10-28T02:31:07.701408Z","vendors":[]},{"abstract_source":null,"affected_versions":[],"affiliations":[],"authors":[],"cves":["CVE-2023-3640"],"date_precision":"exact","fetched_at":"2026-11-09T06:05:29.072272Z","first_seen_at":"2026-11-09T06:05:29.072272Z","id":"osv:CVE-2023-3640","is_backfill":false,"lang":"en","products":[],"published_at":"2023-07-24T16:15:13.063000Z","published_year":null,"raw_text":null,"references":["https://access.redhat.com/errata/RHSA-2023:6583","https://access.redhat.com/security/cve/CVE-2023-3640","https://bugzilla.redhat.com/show_bug.cgi?id=2217523"],"risk":{"cvss_score":null,"cvss_vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","due_date":null,"epss_percentile":null,"epss_score":null,"exploit_in_the_wild":null,"exploit_maturity":"unreported","exploit_references":[],"has_public_exploit":false,"kev_date_added":null,"kev_listed":false,"kev_status":"unknown","known_exploited":null,"known_ransomware":null,"patch_references":[],"patch_status":"unknown","severity":null},"source_info":{"link_kind":"article","native_id":"CVE-2023-3640","source":"osv","source_name":"OSV.dev","source_quality":"primary","source_sub":"osv.dev","source_url":"https://osv.dev/vulnerability/CVE-2023-3640"},"summary":"A possible unauthorized memory access flaw was found in the Linux kernel's cpu_entry_area mapping of X86 CPU data to memory, where a user may guess the location of exception stacks or other important data. Based on the previous CVE-2023-0597, the 'Randomize per-cpu entry area' feature was implemented in /arch/x86/mm/cpu_entry_area.c, which works through the init_cea_offsets() function when KASLR is enabled. However, despite this feature, there is still a risk of per-cpu entry area leaks. This issue could allow a local user to gain access to some important data with memory in an expected location and potentially escalate their privileges on the system.","threat_meta":null,"title":"CVE-2023-3640","topics":["advisory"],"type":"advisory","updated_at":"2026-03-14T12:07:49.018353Z","vendors":[]}],"meta":{"cve_inputs":["CVE-2026-8639","CVE-2026-82830","CVE-2026-17408","CVE-2026-17401","CVE-2026-17399","CVE-2026-17359","CVE-2026-17342","CVE-2026-17340","CVE-2026-17335","CVE-2026-17239","CVE-2026-17150","CVE-2026-17147","CVE-2026-17140","CVE-2026-17117","CVE-2026-124568","CVE-2026-124567","CVE-2026-124566","CVE-2026-124565","CVE-2026-113364","CVE-2026-113363","CVE-2026-105002","CVE-2026-13732","CVE-2026-124610","CVE-2026-124564","CVE-2026-124563","CVE-2026-124562","CVE-2026-124561","CVE-2026-113362","CVE-2023-3640","CVE-2023-32255","CVE-2023-32253","CVE-2023-32251","CVE-2026-78002","CVE-2026-124560","CVE-2026-124558","CVE-2026-124557","CVE-2026-124556","CVE-2026-121825"],"errors":[],"fetched_at":"2026-11-09T06:05:29.072272+00:00","normalized_count":4,"not_found_count":34,"osv_id_count":4,"query_count":38,"raw_count":4,"source":"OSV.dev /v1/vulns","status":"success"}}
