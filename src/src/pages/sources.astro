---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCard from '../components/SourceCard.astro';
import { getAllSources, getSourceCapabilities } from '../lib/sources';
import type { SourceConfig } from '../lib/sources';

const sources = getAllSources();

// Define groups in order (Capability Matrix)
const groups = [
  '学术论文与前沿研究',
  '漏洞预警与深度分析',
  '威胁情报与 APT 追踪',
  '官方厂商安全公告',
  '综合安全资讯与社区',
  '官方应急响应与政策',
  '漏洞库与开源生态'
];

// Group the sources (Many-to-Many mapping)
const groupedSources: Record<string, SourceConfig[]> = {};
groups.forEach(g => groupedSources[g] = []);

sources.forEach(source => {
  const capabilities = getSourceCapabilities(source);
  
  capabilities.forEach(cap => {
    if (groupedSources[cap]) {
      groupedSources[cap].push(source);
    } else {
      // Fallback
      groupedSources['综合安全资讯与社区'].push(source);
    }
  });
});

// Remove duplicates within each group just in case
Object.keys(groupedSources).forEach(group => {
  const uniqueSources = Array.from(new Map(groupedSources[group].map(item => [item.id, item])).values());
  groupedSources[group] = uniqueSources;
});
---

<BaseLayout title="Data Sources - Cyber Security Daily Radar" description="List of data sources and trust model">
  <header class="page-header">
    <h1>Data Sources & Trust Model</h1>
    <div class="description">
      <p>本站按“核心安全能力（Capability）”分类展示所有数据源，同一个安全机构可能同时具备多项能力（如 360CERT 既做漏洞预警，也做 APT 追踪），因此会出现在多个分类下。</p>
      <p>数据来源包括：厂商公告、漏洞库、威胁情报、开源安全等。</p>
      <p>⚠️ <strong>注意事项：</strong>所有安全摘要由 LLM 自动化生成，仅供参考，实际细节与建议请以原始来源为准。本站不提供 exploit 代码、payload 或攻击复现步骤。</p>
    </div>
  </header>

  <div class="content-wrapper">
    {groups.map(groupName => {
      const groupItems = groupedSources[groupName];
      return (
        <details class="group-section">
          <summary>
            <h2>{groupName} <span class="count">({groupItems.length})</span></h2>
          </summary>
          
          <div class="group-content">
            {groupItems.length === 0 ? (
              <p class="empty-state">暂无数据</p>
            ) : (
              <div class="grid">
                {groupItems.map(item => (
                  <SourceCard source={item} />
                ))}
              </div>
            )}
          </div>
        </details>
      );
    })}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    position: relative;
  }
  
  .page-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 120px;
    height: 2px;
    background: linear-gradient(90deg, #d8b66c, #5bbce4, transparent);
  }
  
  h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    color: #17324d;
    font-family: var(--font-serif, "Noto Serif SC", serif);
    font-weight: 600;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  h1::before {
    content: '✦';
    color: #d8b66c;
    font-size: 1.8rem;
    animation: pulseGold 3s ease-in-out infinite;
  }
  
  .description {
    background: linear-gradient(to right, rgba(91, 188, 228, 0.08), rgba(255, 255, 255, 0.4));
    border-left: 4px solid #5bbce4;
    border-right: 1px solid rgba(91, 188, 228, 0.2);
    border-top: 1px solid rgba(91, 188, 228, 0.2);
    border-bottom: 1px solid rgba(91, 188, 228, 0.2);
    padding: 1.25rem 1.5rem;
    border-radius: 4px 8px 8px 4px;
    color: #17324d;
    font-size: 0.95rem;
    line-height: 1.7;
    box-shadow: 0 2px 8px rgba(47, 128, 183, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  
  .description p {
    margin: 0.6rem 0;
  }
  
  .description strong {
    color: #2f80b7;
  }
  
  .group-section {
    margin-bottom: 2.5rem;
    border: 1px solid rgba(216, 182, 108, 0.3);
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(238, 248, 255, 0.4) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(47, 128, 183, 0.05);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .group-section:hover {
    box-shadow: 0 6px 20px rgba(47, 128, 183, 0.1), inset 0 0 0 1px rgba(255, 255, 255, 0.6);
  }
  
  .group-section summary {
    cursor: pointer;
    list-style: none; /* Hide default arrow */
    padding: 1.2rem 1.5rem;
    background: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(91, 188, 228, 0.2);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }
  
  .group-section summary::-webkit-details-marker {
    display: none;
  }
  
  .group-section summary:hover {
    background: rgba(255, 255, 255, 0.8);
  }
  
  /* Add custom arrow */
  .group-section summary::before {
    content: "▶";
    display: inline-block;
    margin-right: 1rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 0.85rem;
    color: #5bbce4;
  }
  
  .group-section[open] summary::before {
    transform: rotate(90deg);
    color: #d8b66c;
  }
  
  .group-section[open] summary {
    border-bottom: 1px solid rgba(216, 182, 108, 0.3);
    background: linear-gradient(to right, rgba(91, 188, 228, 0.05), rgba(255, 255, 255, 0.6));
  }
  
  /* When closed, remove bottom border of summary if it's the only thing */
  .group-section:not([open]) summary {
    border-bottom: none;
  }
  
  h2 {
    font-size: 1.35rem;
    margin: 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    color: #17324d;
    font-family: var(--font-serif, "Noto Serif SC", serif);
    font-weight: 600;
  }
  
  .group-content {
    padding: 1.5rem;
  }
  
  .count {
    font-size: 1rem;
    color: #5bbce4;
    font-family: var(--font-mono);
    font-weight: 500;
  }
  
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .empty-state {
    color: #5b7c99;
    font-style: italic;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px dashed rgba(91, 188, 228, 0.4);
    border-radius: 8px;
    text-align: center;
    font-size: 0.95rem;
  }

  @keyframes pulseGold {
    0% { opacity: 0.8; transform: scale(1); text-shadow: 0 0 10px rgba(216, 182, 108, 0.4); }
    50% { opacity: 1; transform: scale(1.1); text-shadow: 0 0 20px rgba(216, 182, 108, 0.8); }
    100% { opacity: 0.8; transform: scale(1); text-shadow: 0 0 10px rgba(216, 182, 108, 0.4); }
  }
</style>
