---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import VendorAdvisoryCard from '../components/VendorAdvisoryCard.astro';
import ThreatIntelCard from '../components/ThreatIntelCard.astro';
import { getLatestDigest, pickItems } from '../lib/data';
import { formatDate } from '../lib/format';

const digest = getLatestDigest();
const top10 = pickItems(digest, digest.sections.top_10 ?? []);
const highRisk = pickItems(digest, digest.sections.high_risk ?? []);
const research = pickItems(digest, digest.sections.research ?? []);
const supplyChain = pickItems(digest, digest.sections.supply_chain ?? []);
const vendorAdvisories = pickItems(digest, digest.sections.vendor_advisories ?? []);
const threatIntel = pickItems(digest, digest.sections.threat_intel ?? []);
---
<BaseLayout title="Cyber Security Daily Radar">
  <section class="hero">
    <div class="date">{formatDate(digest.date)}</div>
    <p class="one-liner">{digest.hero.one_liner_zh}</p>
    <div class="stats">
      <div><strong>{digest.hero.stats.cve_count}</strong><span>CVE</span></div>
      <div><strong>{digest.hero.stats.kev_added}</strong><span>KEV 新增</span></div>
      <div><strong>{digest.hero.stats.paper_count}</strong><span>论文</span></div>
      <div><strong>{digest.hero.stats.max_epss.toFixed(2)}</strong><span>最高 EPSS</span></div>
    </div>
    {import.meta.env.DEV && digest.is_mock && (
      <div class="mock-banner">当前为 MOCK 数据, 仅用于本地开发预览。</div>
    )}
  </section>

  <div class="dashboard-layout">
    <aside class="sidebar">
      <nav class="nav-list">
        <button class="nav-btn active" data-target="sec-top10">
          <div><span class="icon">🔥</span>每日精选</div>
          <span class="badge">{top10.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-research">
          <div><span class="icon">🧬</span>学术论文</div>
          <span class="badge">{research.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-vuln">
          <div><span class="icon">🚨</span>漏洞预警</div>
          <span class="badge">{highRisk.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-threat">
          <div><span class="icon">🛡️</span>威胁情报</div>
          <span class="badge">{threatIntel.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-vendor">
          <div><span class="icon">🏢</span>厂商公告</div>
          <span class="badge">{vendorAdvisories.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-supply">
          <div><span class="icon">🔗</span>供应链安全</div>
          <span class="badge">{supplyChain.length}</span>
        </button>
      </nav>
    </aside>

    <main class="main-content">
      <section id="sec-top10" class="tab-pane active" data-page-size="10">
        <h2>🔥 每日精选 Top 10</h2>
        <div class="items-container">
        {top10.length === 0 ? (
          <p class="muted">今日暂无精选。</p>
        ) : (
          top10.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-research" class="tab-pane" data-page-size="20">
        <h2>🧬 学术论文</h2>
        <div class="items-container">
        {research.length === 0 ? (
          <p class="muted">今日暂无学术论文。</p>
        ) : (
          research.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-vuln" class="tab-pane" data-page-size="20">
        <h2>🚨 漏洞预警</h2>
        <div class="items-container">
        {highRisk.length === 0 ? (
          <p class="muted">今日暂无漏洞预警。</p>
        ) : (
          highRisk.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-threat" class="tab-pane" data-page-size="20">
        <h2>🛡️ 威胁情报</h2>
        <div class="items-container">
        {threatIntel.length === 0 ? (
          <p class="muted">今日暂无威胁情报。</p>
        ) : (
          threatIntel.map((it) => <div class="item-wrapper"><ThreatIntelCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-vendor" class="tab-pane" data-page-size="20">
        <h2>🏢 厂商公告</h2>
        <div class="items-container">
        {vendorAdvisories.length === 0 ? (
          <p class="muted">今日暂无厂商公告。</p>
        ) : (
          vendorAdvisories.map((it) => <div class="item-wrapper"><VendorAdvisoryCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-supply" class="tab-pane" data-page-size="20">
        <h2>🔗 供应链安全</h2>
        <div class="items-container">
        {supplyChain.length === 0 ? (
          <p class="muted">今日暂无供应链安全情报。</p>
        ) : (
          supplyChain.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.nav-btn');
    const panes = document.querySelectorAll('.tab-pane');
    
    // Pagination setup
    panes.forEach(pane => {
      const items = Array.from(pane.querySelectorAll('.item-wrapper'));
      const pageSize = parseInt(pane.getAttribute('data-page-size') || '20', 10);
      const controlsContainer = pane.querySelector('.pagination-controls');
      
      if (items.length <= pageSize && controlsContainer) {
        controlsContainer.style.display = 'none';
        return;
      }
      
      let currentPage = 1;
      const totalPages = Math.ceil(items.length / pageSize);
      
      function renderPage(page) {
        items.forEach((item, index) => {
          if (index >= (page - 1) * pageSize && index < page * pageSize) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
        
        if (controlsContainer) {
          controlsContainer.innerHTML = `
            <div class="pagination">
              <button class="page-btn" ${page === 1 ? 'disabled' : ''} data-action="prev">上一页</button>
              <span class="page-info">第 ${page} / ${totalPages} 页</span>
              <button class="page-btn" ${page === totalPages ? 'disabled' : ''} data-action="next">下一页</button>
            </div>
          `;
          
          const prevBtn = controlsContainer.querySelector('[data-action="prev"]');
          const nextBtn = controlsContainer.querySelector('[data-action="next"]');
          
          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
          
          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        }
      }
      
      renderPage(1);
    });

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all
        btns.forEach(b => b.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));
        
        // Add active class to current
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        const targetPane = document.getElementById(targetId);
        
        if (targetPane) {
          targetPane.classList.add('active');
          // Optional: Scroll to the top of the content area smoothly
          // targetPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script>

<style>
  .hero {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  .date {
    font-family: ui-monospace, monospace;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .one-liner {
    font-size: 1.15rem;
    margin: 0.5rem 0 1rem;
  }
  .stats {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
  }
  .stats > div {
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .stats strong {
    font-size: 1.4rem;
    color: var(--accent);
  }
  .stats span {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .mock-banner {
    margin-top: 1rem;
    background: #fef3c7;
    color: #92400e;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    display: inline-block;
  }

  /* Dashboard Layout */
  .dashboard-layout {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }
  
  .sidebar {
    position: sticky;
    top: 2rem;
    width: 240px;
    flex-shrink: 0;
  }
  
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.85rem 1.2rem;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--fg-muted);
    transition: all 0.2s ease;
    text-align: left;
    font-family: inherit;
  }
  
  .nav-btn > div {
    display: flex;
    align-items: center;
  }
  
  .nav-btn:hover {
    background: var(--bg-card);
    color: var(--fg);
    border-color: var(--border);
  }
  
  .nav-btn.active {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
    font-weight: 500;
  }
  
  .nav-btn .icon {
    margin-right: 0.6rem;
    font-size: 1.2em;
  }
  
  .nav-btn .badge {
    background: #f1f5f9;
    color: #64748b;
    padding: 0.15rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    transition: all 0.2s;
  }
  
  .nav-btn.active .badge {
    background: #dbeafe;
    color: #1e40af;
  }

  .main-content {
    flex-grow: 1;
    min-width: 0;
  }
  
  .tab-pane {
    display: none;
    animation: fadeIn 0.3s ease;
  }
  
  .tab-pane.active {
    display: block;
  }
  
  .tab-pane h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #e2e8f0;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 6px;
    cursor: pointer;
    color: var(--fg);
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .page-btn:hover:not(:disabled) {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .page-info {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive Design for Mobile */
  @media (max-width: 768px) {
    .dashboard-layout {
      flex-direction: column;
      gap: 1.5rem;
    }
    
    .sidebar {
      position: relative;
      top: 0;
      width: 100%;
      margin: 0 -1rem; /* Full bleed on mobile */
      padding: 0 1rem;
      width: calc(100% + 2rem);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
    }
    
    .sidebar::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
    
    .nav-list {
      flex-direction: row;
      min-width: max-content;
      padding-bottom: 0.5rem;
    }
    
    .nav-btn {
      padding: 0.6rem 1rem;
      border: 1px solid var(--border);
    }
  }
</style>
