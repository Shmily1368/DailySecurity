---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import { getLatestDigest, pickItems } from '../lib/data';
import { getManifest, getCatalog } from '../lib/site';
const digest = getLatestDigest();
const manifest = getManifest();
const catalog = getCatalog();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const top = pickItems(digest, digest.sections.top_10 ?? []).slice(0, 10);
---
<BaseLayout title="Cyber Security Daily Radar">
  <section class="hero">
    <p class="date-badge">{digest.date} · 安全日报</p>
    <h1>每日网络空间安全雷达</h1>
    <p>{digest.hero.one_liner_zh}</p>
    <p class="muted">收录 {digest.items.length} 条 · {manifest.model_count} 条模型摘要 · {manifest.excerpt_count} 条来源摘录</p>
    <p class="muted" id="health-summary">采集状态：{manifest.status === 'degraded' ? '部分来源不可用' : manifest.status === 'healthy' ? '正常' : '历史快照，状态未核验'} · 最近采集 {manifest.checked_at || digest.generated_at}</p>
    <p id="freshness-notice" role="status" hidden></p>
  </section>
  <label class="search-label" for="global-search">检索本期日报</label>
  <input type="search" id="global-search" placeholder="CVE、GHSA、厂商、产品、来源或摘要关键词" autocomplete="off" />
  <div class="dashboard-layout" id="radar" data-version={manifest.version} data-date={digest.date}
       data-catalog={`${base}${manifest.catalog}`} data-search={`${base}${manifest.search}`}>
    <aside>
      <nav class="nav-list" aria-label="情报分类">
        {catalog.groups.map(group => <button class:list={['nav-btn', { active: group.key === 'top_10' }]} data-group={group.key}>{group.label}<span>{group.ids.length}</span></button>)}
      </nav>
      <a href={`${base}/daily/${digest.date}`}>本期完整归档 →</a>
      <details class="source-health">
        <summary>数据源状态</summary>
        {manifest.sources.length === 0 ? <p class="muted">历史快照未提供运行状态。</p> :
          manifest.sources.map(source => <p>{source.name}：{source.status}（{source.count} 条）</p>)}
      </details>
    </aside>
    <section>
      <h2 id="list-title">每日精选</h2>
      <label id="sub-filter-label" hidden>细分分类 <select id="sub-filter"></select></label>
      <p id="list-status" role="status"></p>
      <div id="items-list">{top.map(item => <ItemCard item={item} />)}</div>
      <nav class="page-nav" aria-label="分页">
        <button id="previous-page" disabled>上一页</button>
        <span id="page-info">第 1 / 1 页 · {top.length} 条</span>
        <button id="next-page" disabled>下一页</button>
      </nav>
      <noscript><p>按分类检索需要 JavaScript；也可浏览<a href={`${base}/daily/${digest.date}`}>本期静态归档</a>。</p></noscript>
    </section>
  </div>
</BaseLayout>
<script>
  import '../lib/home';
</script>
<style>
  .hero { border-bottom: 1px solid var(--border-blue); margin-bottom: 1.5rem; padding: 1rem 0; }
  .hero h1 { margin: .5rem 0; font-size: 1.8rem; }
  .date-badge { color: var(--accent); }
  #global-search { display: block; width: 100%; background: white; padding: .85rem 1rem; border: 1px solid var(--border-blue); border-radius: 10px; margin: .4rem 0 1.5rem; }
  .search-label { font-size: .85rem; color: var(--fg-muted); }
  .dashboard-layout { display: grid; grid-template-columns: 210px minmax(0,1fr); gap: 2rem; }
  .nav-list { display: flex; flex-direction: column; gap: .4rem; margin-bottom: 1rem; }
  .nav-btn { display: flex; justify-content: space-between; border: 1px solid transparent; background: transparent; padding: .7rem; cursor: pointer; border-radius: 8px; text-align: left; }
  .nav-btn.active { background: white; color: var(--accent); border-color: var(--border-blue); }
  #list-title { margin: 0 0 1rem; }
  select { background: white; border: 1px solid var(--border-blue); border-radius: 6px; padding: .4rem; max-width: 100%; }
  .source-health { font-size: .8rem; margin-top: 1.5rem; color: var(--fg-muted); }
  #freshness-notice { padding: .7rem; background: white; border: 1px solid var(--border-blue); border-radius: 8px; }
  @media (max-width: 700px) { .dashboard-layout { grid-template-columns: 1fr; gap: 1rem; } .nav-list { flex-direction: row; overflow-x: auto; } .nav-btn { gap: .6rem; white-space: nowrap; } .source-health { margin-top: .5rem; } }
</style>
