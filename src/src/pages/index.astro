---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import VendorAdvisoryCard from '../components/VendorAdvisoryCard.astro';
import ThreatIntelCard from '../components/ThreatIntelCard.astro';
import { getLatestDigest, pickItems } from '../lib/data';
import { formatDate } from '../lib/format';

const digest = getLatestDigest();
const top10 = pickItems(digest, digest.sections.top_10 ?? []);

const vulnExploited = pickItems(digest, digest.sections.vuln_exploited ?? []);
const vulnPoc = pickItems(digest, digest.sections.vuln_poc ?? []);
const vulnSupplyChain = pickItems(digest, digest.sections.vuln_supply_chain ?? []);
const vulnBaseline = pickItems(digest, digest.sections.vuln_baseline ?? []);
const vulnTotalCount = vulnExploited.length + vulnPoc.length + vulnSupplyChain.length + vulnBaseline.length;

const threatApt = pickItems(digest, digest.sections.threat_apt ?? []);
const threatCybercrime = pickItems(digest, digest.sections.threat_cybercrime ?? []);
const threatCampaigns = pickItems(digest, digest.sections.threat_campaigns ?? []);
const threatMacro = pickItems(digest, digest.sections.threat_macro ?? []);
const threatTotalCount = threatApt.length + threatCybercrime.length + threatCampaigns.length + threatMacro.length;

const vendorCloud = pickItems(digest, digest.sections.vendor_cloud ?? []);
const vendorOs = pickItems(digest, digest.sections.vendor_os ?? []);
const vendorIot = pickItems(digest, digest.sections.vendor_iot ?? []);
const vendorTotalCount = vendorCloud.length + vendorOs.length + vendorIot.length;

const researchAi = pickItems(digest, digest.sections.research_ai ?? []);
const researchCrypto = pickItems(digest, digest.sections.research_crypto ?? []);
const researchSystems = pickItems(digest, digest.sections.research_systems ?? []);
const researchOthers = pickItems(digest, digest.sections.research_others ?? []);
const researchTotalCount = researchAi.length + researchCrypto.length + researchSystems.length + researchOthers.length;
---
<BaseLayout title="Cyber Security Daily Radar">
  <section class="hero">
    <div class="hero-inner">
      <div class="date-badge">✧ {formatDate(digest.date)} ✧</div>
      <p class="one-liner">{digest.hero.one_liner_zh}</p>
      <div class="stats">
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="stat-info">
            <strong>{digest.hero.stats.cve_count}</strong>
            <span>今日 CVE</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div class="stat-info">
            <strong>{digest.hero.stats.kev_added}</strong>
            <span>KEV 新增</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div class="stat-info">
            <strong>{digest.hero.stats.paper_count}</strong>
            <span>学术论文</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <div class="stat-info">
            <strong style="letter-spacing: -0.05em;">{digest.hero.stats.max_epss.toFixed(2)}</strong>
            <span>最高 EPSS</span>
          </div>
        </div>
      </div>
      {import.meta.env.DEV && digest.is_mock && (
        <div class="mock-banner">当前为 MOCK 数据, 仅用于本地开发预览。</div>
      )}
    </div>
  </section>

  <div class="search-container">
    <div class="search-input-wrapper">
      <span class="search-icon">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </span>
      <input type="search" id="global-search" placeholder="在水镜档案中检索 CVE、厂商、论文、威胁情报..." autocomplete="off" />
    </div>
  </div>

  <div id="search-results-container" style="display: none;">
    <div class="section-header">
      <h2 id="search-results-title">🔍 搜索结果</h2>
    </div>
    <div class="items-container" id="search-results-list"></div>
  </div>

  <div class="dashboard-layout" id="main-dashboard">
    <aside class="sidebar">
      <nav class="nav-list">
        <button class="nav-btn active" data-target="sec-top10">
          <div class="nav-btn-content">
            <svg viewBox="0 0 24 24" class="icon"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            每日精选
          </div>
          <span class="badge">{top10.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-research">
          <div class="nav-btn-content">
            <svg viewBox="0 0 24 24" class="icon"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            学术论文
          </div>
          <span class="badge">{researchTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-vuln">
          <div class="nav-btn-content">
            <svg viewBox="0 0 24 24" class="icon"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            漏洞预警
          </div>
          <span class="badge">{vulnTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-threat">
          <div class="nav-btn-content">
            <svg viewBox="0 0 24 24" class="icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            威胁情报
          </div>
          <span class="badge">{threatTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-vendor">
          <div class="nav-btn-content">
            <svg viewBox="0 0 24 24" class="icon"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/></svg>
            厂商公告
          </div>
          <span class="badge">{vendorTotalCount}</span>
        </button>
      </nav>
    </aside>

    <main class="main-content">
      <section id="sec-top10" class="tab-pane active" data-page-size="10">
        <div class="section-header">
          <h2>🔥 每日精选 Top 10</h2>
          <div class="section-subtitle">Vulnerability Dossier & Key Findings</div>
        </div>
        <div class="items-container">
        {top10.length === 0 ? (
          <p class="muted">今日暂无精选。</p>
        ) : (
          top10.map((it) => <div class="item-wrapper" data-item-id={it.id}><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-research" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🧬 学术论文</h2>
          <div class="section-subtitle">Research Archive & Cutting-Edge Studies</div>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="research-ai" data-count={researchAi.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"/><path d="M12 6v6l4 2"/></svg>
              AI 安全 ({researchAi.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="research-systems" data-count={researchSystems.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              系统与软件 ({researchSystems.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="research-crypto" data-count={researchCrypto.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              密码与隐私 ({researchCrypto.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="research-others" data-count={researchOthers.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              综合前沿 ({researchOthers.length})
            </button>
          </div>
        </div>

        <div id="research-ai" class="sub-pane active">
          <div class="items-container">
            {researchAi.length === 0 ? <p class="muted">今日暂无内容。</p> : researchAi.map(item => <div class="item-wrapper" data-item-id={item.id}><ItemCard item={item} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
        
        <div id="research-systems" class="sub-pane">
          <div class="items-container">
            {researchSystems.length === 0 ? <p class="muted">今日暂无内容。</p> : researchSystems.map(item => <div class="item-wrapper" data-item-id={item.id}><ItemCard item={item} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div id="research-crypto" class="sub-pane">
          <div class="items-container">
            {researchCrypto.length === 0 ? <p class="muted">今日暂无内容。</p> : researchCrypto.map(item => <div class="item-wrapper" data-item-id={item.id}><ItemCard item={item} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div id="research-others" class="sub-pane">
          <div class="items-container">
            {researchOthers.length === 0 ? <p class="muted">今日暂无内容。</p> : researchOthers.map(item => <div class="item-wrapper" data-item-id={item.id}><ItemCard item={item} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-vuln" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🚨 漏洞预警</h2>
          <div class="section-subtitle">Vulnerability Alerts & Public Exploits</div>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="vuln-exploited" data-count={vulnExploited.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              在野利用 ({vulnExploited.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="vuln-poc" data-count={vulnPoc.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              深度分析与PoC ({vulnPoc.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="vuln-supply" data-count={vulnSupplyChain.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M20 16.28a2 2 0 0 1-1.02 1.73l-6 3.46a2 2 0 0 1-1.96 0l-6-3.46A2 2 0 0 1 4 16.28V7.72a2 2 0 0 1 1.02-1.73l6-3.46a2 2 0 0 1 1.96 0l6 3.46A2 2 0 0 1 20 7.72v8.56z"/><polyline points="12 22 12 12 20 7.72"/><polyline points="12 12 4 7.72"/></svg>
              供应链与开源 ({vulnSupplyChain.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="vuln-baseline" data-count={vulnBaseline.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              常规披露 ({vulnBaseline.length})
            </button>
          </div>
        </div>
        
        <div class="sub-pane active" id="vuln-exploited">
          <div class="items-container">
          {vulnExploited.length === 0 ? <p class="muted">今日暂无在野利用漏洞。</p> : vulnExploited.map((it) => <div class="item-wrapper" data-item-id={it.id}><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
        
        <div class="sub-pane" id="vuln-poc">
          <div class="items-container">
          {vulnPoc.length === 0 ? <p class="muted">今日暂无第三方深度分析。</p> : vulnPoc.map((it) => <div class="item-wrapper" data-item-id={it.id}><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vuln-supply">
          <div class="items-container">
          {vulnSupplyChain.length === 0 ? <p class="muted">今日暂无供应链与开源漏洞。</p> : vulnSupplyChain.map((it) => <div class="item-wrapper" data-item-id={it.id}><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vuln-baseline">
          <div class="items-container">
          {vulnBaseline.length === 0 ? <p class="muted">今日暂无常规漏洞披露。</p> : vulnBaseline.map((it) => <div class="item-wrapper" data-item-id={it.id}><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-threat" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🛡️ 威胁情报</h2>
          <div class="section-subtitle">Threat Intelligence & Campaigns</div>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="threat-apt" data-count={threatApt.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M2 12h4l3-9 5 18 3-9h5"/></svg>
              APT与高级威胁 ({threatApt.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="threat-cybercrime" data-count={threatCybercrime.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              勒索与黑产 ({threatCybercrime.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="threat-campaigns" data-count={threatCampaigns.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              战术与攻击活动 ({threatCampaigns.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="threat-macro" data-count={threatMacro.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              宏观态势 ({threatMacro.length})
            </button>
          </div>
        </div>

        <div class="sub-pane active" id="threat-apt">
          <div class="items-container">
          {threatApt.length === 0 ? <p class="muted">今日暂无APT情报。</p> : threatApt.map((it) => <div class="item-wrapper" data-item-id={it.id}><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-cybercrime">
          <div class="items-container">
          {threatCybercrime.length === 0 ? <p class="muted">今日暂无勒索与黑产情报。</p> : threatCybercrime.map((it) => <div class="item-wrapper" data-item-id={it.id}><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-campaigns">
          <div class="items-container">
          {threatCampaigns.length === 0 ? <p class="muted">今日暂无具体战术情报。</p> : threatCampaigns.map((it) => <div class="item-wrapper" data-item-id={it.id}><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-macro">
          <div class="items-container">
          {threatMacro.length === 0 ? <p class="muted">今日暂无宏观态势报告。</p> : threatMacro.map((it) => <div class="item-wrapper" data-item-id={it.id}><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-vendor" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🏢 厂商公告</h2>
          <div class="section-subtitle">Vendor Bulletin & Security Advisories</div>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="vendor-cloud" data-count={vendorCloud.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
              云与网络设施 ({vendorCloud.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="vendor-os" data-count={vendorOs.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              操作系统与软件 ({vendorOs.length})
            </button>
            <button class="sub-tab-btn" data-subtarget="vendor-iot" data-count={vendorIot.length}>
              <svg viewBox="0 0 24 24" class="sub-tab-icon"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
              物联网与工控 ({vendorIot.length})
            </button>
          </div>
        </div>

        <div class="sub-pane active" id="vendor-cloud">
          <div class="items-container">
          {vendorCloud.length === 0 ? <p class="muted">今日暂无云厂商公告。</p> : vendorCloud.map((it) => <div class="item-wrapper" data-item-id={it.id}><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vendor-os">
          <div class="items-container">
          {vendorOs.length === 0 ? <p class="muted">今日暂无操作系统厂商公告。</p> : vendorOs.map((it) => <div class="item-wrapper" data-item-id={it.id}><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vendor-iot">
          <div class="items-container">
          {vendorIot.length === 0 ? <p class="muted">今日暂无IoT与工控厂商公告。</p> : vendorIot.map((it) => <div class="item-wrapper" data-item-id={it.id}><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      </section>
    </main>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.nav-btn');
    const panes = document.querySelectorAll('.tab-pane');
    
    // Pagination setup
    const subPanes = document.querySelectorAll('.sub-pane, #sec-top10');
    
    subPanes.forEach(pane => {
      const items = Array.from(pane.querySelectorAll('.item-wrapper'));
      const parentTab = pane.closest('.tab-pane') || pane;
      const pageSize = parseInt(parentTab.getAttribute('data-page-size') || '20', 10);
      const controlsContainer = pane.querySelector('.pagination-controls');
      
      if (items.length <= pageSize && controlsContainer) {
        controlsContainer.style.display = 'none';
        return;
      }
      
      let currentPage = 1;
      const totalPages = Math.ceil(items.length / pageSize);
      
      function renderPage(page) {
        items.forEach((item, index) => {
          if (index >= (page - 1) * pageSize && index < page * pageSize) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
        
        if (controlsContainer) {
          controlsContainer.innerHTML = `
            <div class="pagination">
              <button class="page-btn" ${page === 1 ? 'disabled' : ''} data-action="prev">上一页</button>
              <span class="page-info">第 ${page} / ${totalPages} 页</span>
              <button class="page-btn" ${page === totalPages ? 'disabled' : ''} data-action="next">下一页</button>
            </div>
          `;
          
          const prevBtn = controlsContainer.querySelector('[data-action="prev"]');
          const nextBtn = controlsContainer.querySelector('[data-action="next"]');
          
          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
          
          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        }
      }
      
      renderPage(1);
    });

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all
        btns.forEach(b => b.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));
        
        // Add active class to current
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        const targetPane = document.getElementById(targetId);
        
        if (targetPane) {
          targetPane.classList.add('active');
          // Optional: Scroll to the top of the content area smoothly
          // targetPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Sub-tabs logic
    const subTabBtns = document.querySelectorAll('.sub-tab-btn');
    subTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const parentSection = btn.closest('.tab-pane');
        const targetId = btn.getAttribute('data-subtarget');
        
        // Remove active class from buttons in this section
        parentSection.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Hide all sub-panes in this section
        parentSection.querySelectorAll('.sub-pane').forEach(p => p.classList.remove('active'));
        
        // Show target sub-pane
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('active');
        }
      });
    });

    // Global Search Logic
    const searchInput = document.getElementById('global-search');
    const dashboardLayout = document.getElementById('main-dashboard');
    const searchResultsContainer = document.getElementById('search-results-container');
    const searchResultsList = document.getElementById('search-results-list');
    const searchResultsTitle = document.getElementById('search-results-title');
    
    if (searchInput) {
      let timeout = null;
      
      searchInput.addEventListener('input', (e) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          const term = e.target.value.trim().toLowerCase();
          if (!term) {
            searchResultsContainer.style.display = 'none';
            // Important: we need to use flex for dashboard layout if it's the default, but on mobile it might be column.
            // Let's just remove the inline style to let CSS handle it.
            dashboardLayout.style.display = ''; 
            return;
          }

          searchResultsContainer.style.display = 'block';
          dashboardLayout.style.display = 'none';
          searchResultsList.innerHTML = '';

          const allItems = Array.from(document.querySelectorAll('#main-dashboard .item-wrapper'));
          const seenIds = new Set();
          let matchCount = 0;

          allItems.forEach(item => {
            const id = item.getAttribute('data-item-id');
            if (seenIds.has(id)) return; // Deduplicate items that appear in multiple sections

            // Search in text content
            if (item.textContent.toLowerCase().includes(term)) {
              seenIds.add(id);
              const clone = item.cloneNode(true);
              clone.style.display = 'block'; // Ensure it is visible, overriding any pagination inline styles
              searchResultsList.appendChild(clone);
              matchCount++;
            }
          });

          searchResultsTitle.textContent = `🔍 找到 ${matchCount} 条关于 "${e.target.value.trim()}" 的结果`;
          if (matchCount === 0) {
            searchResultsList.innerHTML = '<p class="muted" style="padding: 1rem 0;">未找到相关内容，请尝试更换关键词。</p>';
          }
        }, 200); // 200ms debounce
      });
    }
  });
</script>

