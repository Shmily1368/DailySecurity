---
import BaseLayout from '../layouts/BaseLayout.astro';
import ItemCard from '../components/ItemCard.astro';
import VendorAdvisoryCard from '../components/VendorAdvisoryCard.astro';
import ThreatIntelCard from '../components/ThreatIntelCard.astro';
import { getLatestDigest, pickItems } from '../lib/data';
import { formatDate } from '../lib/format';

const digest = getLatestDigest();
const top10 = pickItems(digest, digest.sections.top_10 ?? []);

const vulnExploited = pickItems(digest, digest.sections.vuln_exploited ?? []);
const vulnPoc = pickItems(digest, digest.sections.vuln_poc ?? []);
const vulnSupplyChain = pickItems(digest, digest.sections.vuln_supply_chain ?? []);
const vulnBaseline = pickItems(digest, digest.sections.vuln_baseline ?? []);
const vulnTotalCount = vulnExploited.length + vulnPoc.length + vulnSupplyChain.length + vulnBaseline.length;

const threatApt = pickItems(digest, digest.sections.threat_apt ?? []);
const threatCybercrime = pickItems(digest, digest.sections.threat_cybercrime ?? []);
const threatCampaigns = pickItems(digest, digest.sections.threat_campaigns ?? []);
const threatMacro = pickItems(digest, digest.sections.threat_macro ?? []);
const threatTotalCount = threatApt.length + threatCybercrime.length + threatCampaigns.length + threatMacro.length;

const vendorCloud = pickItems(digest, digest.sections.vendor_cloud ?? []);
const vendorOs = pickItems(digest, digest.sections.vendor_os ?? []);
const vendorIot = pickItems(digest, digest.sections.vendor_iot ?? []);
const vendorTotalCount = vendorCloud.length + vendorOs.length + vendorIot.length;

const researchAi = pickItems(digest, digest.sections.research_ai ?? []);
const researchCrypto = pickItems(digest, digest.sections.research_crypto ?? []);
const researchSystems = pickItems(digest, digest.sections.research_systems ?? []);
const researchTotalCount = researchAi.length + researchCrypto.length + researchSystems.length;
---
<BaseLayout title="Cyber Security Daily Radar">
  <section class="hero">
    <div class="date">{formatDate(digest.date)}</div>
    <p class="one-liner">{digest.hero.one_liner_zh}</p>
    <div class="stats">
      <div><strong>{digest.hero.stats.cve_count}</strong><span>CVE</span></div>
      <div><strong>{digest.hero.stats.kev_added}</strong><span>KEV 新增</span></div>
      <div><strong>{digest.hero.stats.paper_count}</strong><span>论文</span></div>
      <div><strong>{digest.hero.stats.max_epss.toFixed(2)}</strong><span>最高 EPSS</span></div>
    </div>
    {import.meta.env.DEV && digest.is_mock && (
      <div class="mock-banner">当前为 MOCK 数据, 仅用于本地开发预览。</div>
    )}
  </section>

  <div class="dashboard-layout">
    <aside class="sidebar">
      <nav class="nav-list">
        <button class="nav-btn active" data-target="sec-top10">
          <div><span class="icon">🔥</span>每日精选</div>
          <span class="badge">{top10.length}</span>
        </button>
        <button class="nav-btn" data-target="sec-vuln">
          <div><span class="icon">🚨</span>漏洞预警</div>
          <span class="badge">{vulnTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-threat">
          <div><span class="icon">🛡️</span>威胁情报</div>
          <span class="badge">{threatTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-vendor">
          <div><span class="icon">🏢</span>厂商公告</div>
          <span class="badge">{vendorTotalCount}</span>
        </button>
        <button class="nav-btn" data-target="sec-research">
          <div><span class="icon">🧬</span>学术论文</div>
          <span class="badge">{researchTotalCount}</span>
        </button>
      </nav>
    </aside>

    <main class="main-content">
      <section id="sec-top10" class="tab-pane active" data-page-size="10">
        <h2>🔥 每日精选 Top 10</h2>
        <div class="items-container">
        {top10.length === 0 ? (
          <p class="muted">今日暂无精选。</p>
        ) : (
          top10.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)
        )}
        </div>
        <div class="pagination-controls"></div>
      </section>

      <section id="sec-vuln" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🚨 漏洞预警</h2>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="vuln-exploited">🧨 在野利用 ({vulnExploited.length})</button>
            <button class="sub-tab-btn" data-subtarget="vuln-poc">🔬 深度分析与PoC ({vulnPoc.length})</button>
            <button class="sub-tab-btn" data-subtarget="vuln-supply">📦 供应链与开源 ({vulnSupplyChain.length})</button>
            <button class="sub-tab-btn" data-subtarget="vuln-baseline">📋 常规披露 ({vulnBaseline.length})</button>
          </div>
        </div>
        
        <div class="sub-pane active" id="vuln-exploited">
          <div class="items-container">
          {vulnExploited.length === 0 ? <p class="muted">今日暂无在野利用漏洞。</p> : vulnExploited.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
        
        <div class="sub-pane" id="vuln-poc">
          <div class="items-container">
          {vulnPoc.length === 0 ? <p class="muted">今日暂无第三方深度分析。</p> : vulnPoc.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vuln-supply">
          <div class="items-container">
          {vulnSupplyChain.length === 0 ? <p class="muted">今日暂无供应链与开源漏洞。</p> : vulnSupplyChain.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vuln-baseline">
          <div class="items-container">
          {vulnBaseline.length === 0 ? <p class="muted">今日暂无常规漏洞披露。</p> : vulnBaseline.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-threat" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🛡️ 威胁情报</h2>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="threat-apt">🥷 APT与高级威胁 ({threatApt.length})</button>
            <button class="sub-tab-btn" data-subtarget="threat-cybercrime">💸 勒索与黑产 ({threatCybercrime.length})</button>
            <button class="sub-tab-btn" data-subtarget="threat-campaigns">🎯 战术与攻击活动 ({threatCampaigns.length})</button>
            <button class="sub-tab-btn" data-subtarget="threat-macro">📊 宏观态势 ({threatMacro.length})</button>
          </div>
        </div>

        <div class="sub-pane active" id="threat-apt">
          <div class="items-container">
          {threatApt.length === 0 ? <p class="muted">今日暂无APT情报。</p> : threatApt.map((it) => <div class="item-wrapper"><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-cybercrime">
          <div class="items-container">
          {threatCybercrime.length === 0 ? <p class="muted">今日暂无勒索与黑产情报。</p> : threatCybercrime.map((it) => <div class="item-wrapper"><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-campaigns">
          <div class="items-container">
          {threatCampaigns.length === 0 ? <p class="muted">今日暂无具体战术情报。</p> : threatCampaigns.map((it) => <div class="item-wrapper"><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="threat-macro">
          <div class="items-container">
          {threatMacro.length === 0 ? <p class="muted">今日暂无宏观态势报告。</p> : threatMacro.map((it) => <div class="item-wrapper"><ThreatIntelCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-vendor" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🏢 厂商公告</h2>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="vendor-cloud">☁️ 云与网络设施 ({vendorCloud.length})</button>
            <button class="sub-tab-btn" data-subtarget="vendor-os">💻 操作系统与软件 ({vendorOs.length})</button>
            <button class="sub-tab-btn" data-subtarget="vendor-iot">📱 物联网与工控 ({vendorIot.length})</button>
          </div>
        </div>

        <div class="sub-pane active" id="vendor-cloud">
          <div class="items-container">
          {vendorCloud.length === 0 ? <p class="muted">今日暂无云厂商公告。</p> : vendorCloud.map((it) => <div class="item-wrapper"><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vendor-os">
          <div class="items-container">
          {vendorOs.length === 0 ? <p class="muted">今日暂无操作系统厂商公告。</p> : vendorOs.map((it) => <div class="item-wrapper"><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="vendor-iot">
          <div class="items-container">
          {vendorIot.length === 0 ? <p class="muted">今日暂无IoT与工控厂商公告。</p> : vendorIot.map((it) => <div class="item-wrapper"><VendorAdvisoryCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>

      <section id="sec-research" class="tab-pane" data-page-size="20">
        <div class="section-header">
          <h2>🧬 学术论文</h2>
          <div class="sub-tabs">
            <button class="sub-tab-btn active" data-subtarget="research-ai">🤖 AI 安全 ({researchAi.length})</button>
            <button class="sub-tab-btn" data-subtarget="research-crypto">🔐 密码学与架构 ({researchCrypto.length})</button>
            <button class="sub-tab-btn" data-subtarget="research-systems">🌐 系统与网络 ({researchSystems.length})</button>
          </div>
        </div>

        <div class="sub-pane active" id="research-ai">
          <div class="items-container">
          {researchAi.length === 0 ? <p class="muted">今日暂无AI安全相关论文。</p> : researchAi.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="research-crypto">
          <div class="items-container">
          {researchCrypto.length === 0 ? <p class="muted">今日暂无密码学相关论文。</p> : researchCrypto.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>

        <div class="sub-pane" id="research-systems">
          <div class="items-container">
          {researchSystems.length === 0 ? <p class="muted">今日暂无系统与网络安全论文。</p> : researchSystems.map((it) => <div class="item-wrapper"><ItemCard item={it} /></div>)}
          </div>
          <div class="pagination-controls"></div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btns = document.querySelectorAll('.nav-btn');
    const panes = document.querySelectorAll('.tab-pane');
    
    // Pagination setup
    const subPanes = document.querySelectorAll('.sub-pane, #sec-top10');
    
    subPanes.forEach(pane => {
      const items = Array.from(pane.querySelectorAll('.item-wrapper'));
      const parentTab = pane.closest('.tab-pane') || pane;
      const pageSize = parseInt(parentTab.getAttribute('data-page-size') || '20', 10);
      const controlsContainer = pane.querySelector('.pagination-controls');
      
      if (items.length <= pageSize && controlsContainer) {
        controlsContainer.style.display = 'none';
        return;
      }
      
      let currentPage = 1;
      const totalPages = Math.ceil(items.length / pageSize);
      
      function renderPage(page) {
        items.forEach((item, index) => {
          if (index >= (page - 1) * pageSize && index < page * pageSize) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
        
        if (controlsContainer) {
          controlsContainer.innerHTML = `
            <div class="pagination">
              <button class="page-btn" ${page === 1 ? 'disabled' : ''} data-action="prev">上一页</button>
              <span class="page-info">第 ${page} / ${totalPages} 页</span>
              <button class="page-btn" ${page === totalPages ? 'disabled' : ''} data-action="next">下一页</button>
            </div>
          `;
          
          const prevBtn = controlsContainer.querySelector('[data-action="prev"]');
          const nextBtn = controlsContainer.querySelector('[data-action="next"]');
          
          if (prevBtn) {
            prevBtn.addEventListener('click', () => {
              if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
          
          if (nextBtn) {
            nextBtn.addEventListener('click', () => {
              if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                pane.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            });
          }
        }
      }
      
      renderPage(1);
    });

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all
        btns.forEach(b => b.classList.remove('active'));
        panes.forEach(p => p.classList.remove('active'));
        
        // Add active class to current
        btn.classList.add('active');
        const targetId = btn.getAttribute('data-target');
        const targetPane = document.getElementById(targetId);
        
        if (targetPane) {
          targetPane.classList.add('active');
          // Optional: Scroll to the top of the content area smoothly
          // targetPane.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Sub-tabs logic
    const subTabBtns = document.querySelectorAll('.sub-tab-btn');
    subTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const parentSection = btn.closest('.tab-pane');
        const targetId = btn.getAttribute('data-subtarget');
        
        // Remove active class from buttons in this section
        parentSection.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Hide all sub-panes in this section
        parentSection.querySelectorAll('.sub-pane').forEach(p => p.classList.remove('active'));
        
        // Show target sub-pane
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('active');
        }
      });
    });
  });
</script>

<style>
  .hero {
    padding: 1rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  .date {
    font-family: ui-monospace, monospace;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .one-liner {
    font-size: 1.15rem;
    margin: 0.5rem 0 1rem;
  }
  .stats {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
  }
  .stats > div {
    display: flex; flex-direction: column; align-items: flex-start;
  }
  .stats strong {
    font-size: 1.4rem;
    color: var(--accent);
  }
  .stats span {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .mock-banner {
    margin-top: 1rem;
    background: #fef3c7;
    color: #92400e;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    display: inline-block;
  }

  /* Dashboard Layout */
  .dashboard-layout {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }
  
  .sidebar {
    position: sticky;
    top: 2rem;
    width: 240px;
    flex-shrink: 0;
  }
  
  .nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.85rem 1.2rem;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--fg-muted);
    transition: all 0.2s ease;
    text-align: left;
    font-family: inherit;
  }
  
  .nav-btn > div {
    display: flex;
    align-items: center;
  }
  
  .nav-btn:hover {
    background: var(--bg-card);
    color: var(--fg);
    border-color: var(--border);
  }
  
  .nav-btn.active {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #bfdbfe;
    font-weight: 500;
  }
  
  .nav-btn .icon {
    margin-right: 0.6rem;
    font-size: 1.2em;
  }
  
  .nav-btn .badge {
    background: #f1f5f9;
    color: #64748b;
    padding: 0.15rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    transition: all 0.2s;
  }
  
  .nav-btn.active .badge {
    background: #dbeafe;
    color: #1e40af;
  }

  .main-content {
    flex-grow: 1;
    min-width: 0;
  }
  
  .tab-pane {
    display: none;
    animation: fadeIn 0.3s ease;
  }
  
  .tab-pane.active {
    display: block;
  }
  
  .section-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
  }

  .section-header h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  
  .sub-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .sub-tab-btn {
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid transparent;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .sub-tab-btn:hover {
    background: #e2e8f0;
  }
  
  .sub-tab-btn.active {
    background: #dbeafe;
    color: #1e40af;
    border-color: #bfdbfe;
    font-weight: 500;
  }
  
  .sub-pane {
    display: none;
    animation: fadeIn 0.3s ease;
  }
  
  .sub-pane.active {
    display: block;
  }

  /* Handle top10 h2 specifically since it doesn't have a section-header wrapper */
  #sec-top10 h2 {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #e2e8f0;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 6px;
    cursor: pointer;
    color: var(--fg);
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .page-btn:hover:not(:disabled) {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }

  .page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .page-info {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Responsive Design for Mobile */
  @media (max-width: 768px) {
    .dashboard-layout {
      flex-direction: column;
      gap: 1.5rem;
    }
    
    .sidebar {
      position: relative;
      top: 0;
      width: 100%;
      margin: 0 -1rem; /* Full bleed on mobile */
      padding: 0 1rem;
      width: calc(100% + 2rem);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
    }
    
    .sidebar::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }
    
    .nav-list {
      flex-direction: row;
      min-width: max-content;
      padding-bottom: 0.5rem;
    }
    
    .nav-btn {
      padding: 0.6rem 1rem;
      border: 1px solid var(--border);
    }
  }
</style>
