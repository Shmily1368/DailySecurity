---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ItemCard from '../../components/ItemCard.astro';
import { getAllTopics, getAllItems } from '../../lib/data';

export async function getStaticPaths() {
  const topics = getAllTopics();
  return topics.map(topic => ({
    params: { topic }
  }));
}

const { topic } = Astro.params;
const allItems = getAllItems();

const relatedItems = allItems.filter(item => {
  const llmTags = item.llm_summary?.tags ?? [];
  const rawTopics = item.topics ?? [];
  return llmTags.includes(topic as string) || rawTopics.includes(topic as string);
});
---

<BaseLayout title={`#${topic} 主题 - Cyber Security Daily Radar`}>
  <section class="topic-header">
    <h1>#{topic}</h1>
    <p class="stats-info">共收录 {relatedItems.length} 条相关安全情报。</p>
    <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/topics"} class="back-link">← 返回所有主题</a>
  </section>

  <section class="item-list">
    {relatedItems.length === 0 ? (
      <p class="muted">该主题下暂无内容。</p>
    ) : (
      relatedItems.map(it => <ItemCard item={it} />)
    )}
  </section>
</BaseLayout>

<style>
  .topic-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    margin: 0 0 0.5rem 0;
    color: var(--accent);
  }
  .stats-info {
    color: var(--fg-muted);
    margin: 0 0 1rem 0;
  }
  .back-link {
    font-size: 0.9rem;
    color: var(--accent);
  }
  .item-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
