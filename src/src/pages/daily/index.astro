---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllDates, getDailyDigest } from '../../lib/data';
import { formatDate } from '../../lib/format';

const dates = getAllDates();
const archiveData = dates.map(date => {
  try {
    const digest = getDailyDigest(date);
    return { date, stats: digest.hero?.stats || null, heroLine: digest.hero?.one_liner_zh || '' };
  } catch (e) {
    return { date, stats: null, heroLine: '' };
  }
});
---

<BaseLayout title="历史归档 - Cyber Security Daily Radar">
  <section class="archive-list">
    <h1>📅 历史归档</h1>
    <p class="muted">查看过去的安全雷达摘要。</p>
    
    {archiveData.length === 0 ? (
      <p>暂无归档数据。</p>
    ) : (
      <ul class="dates">
        {archiveData.map(({ date, stats, heroLine }) => (
          <li>
            <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + `/daily/${date}`} class="date-link">
              <div class="date-header">
                <span class="date-raw">{date}</span>
                <span class="date-fmt">{formatDate(date)}</span>
              </div>
              {heroLine && <div class="hero-line">{heroLine}</div>}
              {stats && (
                <div class="date-stats">
                  <div class="stat-item" title="漏洞情报">
                    <span class="icon">🐛</span>
                    <span>{stats.cve_count || 0}</span>
                  </div>
                  <div class="stat-item" title="在野利用">
                    <span class="icon">🔥</span>
                    <span>{stats.kev_added || 0}</span>
                  </div>
                  <div class="stat-item" title="学术论文">
                    <span class="icon">📄</span>
                    <span>{stats.paper_count || 0}</span>
                  </div>
                  <div class="stat-item" title="安全公告与威胁情报">
                    <span class="icon">🛡️</span>
                    <span>{stats.advisory_count || 0}</span>
                  </div>
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .archive-list {
    max-width: 900px;
    margin: 0 auto;
  }
  h1 { margin-top: 0; }
  .dates {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .date-link {
    display: flex;
    flex-direction: column;
    padding: 1.2rem 1.5rem;
    border: 1px solid rgba(91, 188, 228, 0.3);
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(238, 248, 255, 0.4) 100%);
    box-shadow: 0 4px 16px rgba(47, 128, 183, 0.05);
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    height: 100%;
    text-decoration: none;
  }
  .date-link:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(238, 248, 255, 0.8) 100%);
    border-color: rgba(216, 182, 108, 0.6);
    box-shadow: 0 6px 20px rgba(47, 128, 183, 0.1);
    transform: translateY(-4px);
    text-decoration: none;
  }
  .date-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid rgba(91, 188, 228, 0.2);
    padding-bottom: 0.5rem;
  }
  .date-raw {
    font-size: 1.2rem;
    font-weight: 600;
    color: #17324d;
    font-family: var(--font-mono);
  }
  .date-fmt {
    font-size: 0.85rem;
    color: #5b7c99;
  }
  .hero-line {
    font-size: 0.95rem;
    color: #23384f;
    margin-bottom: 1rem;
    flex-grow: 1;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .date-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.5);
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px dashed rgba(91, 188, 228, 0.3);
    margin-top: auto;
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.9rem;
    color: #2f80b7;
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .icon {
    font-size: 1rem;
  }
</style>
