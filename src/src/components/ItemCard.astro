---
import type { DigestItem } from '../lib/data';
import PaperCard from './PaperCard.astro';
import VulnerabilityCard from './VulnerabilityCard.astro';
import AdvisoryCard from './AdvisoryCard.astro';

export interface Props {
  item: DigestItem;
}

const { item } = Astro.props;
---
{item.type === 'paper' ? (
  <PaperCard item={item} />
) : item.type === 'cve' || item.type === 'kev' ? (
  <VulnerabilityCard item={item} />
) : item.type === 'advisory' ? (
  <AdvisoryCard item={item} />
) : (
  <VulnerabilityCard item={item} />
)}