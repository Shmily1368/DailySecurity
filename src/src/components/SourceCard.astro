---
import { getSourceCapabilities, normalizeRegionLabel } from '../lib/sources';
import type { SourceConfig } from '../lib/sources';

export interface Props {
  source: SourceConfig;
}

const { source } = Astro.props;
const regionLabel = normalizeRegionLabel(source.region);
const capabilities = getSourceCapabilities(source);

function getQualityBadgeClass(quality: string) {
  if (quality === 'primary') return 'badge-primary';
  if (quality === 'secondary') return 'badge-secondary';
  return 'badge-community';
}

function getQualityLabel(quality: string) {
  if (quality === 'primary') return '高可信 (官方)';
  if (quality === 'secondary') return '中可信 (媒体/研究)';
  return '低可信 (社区)';
}
---

<div class="source-card">
  <div class="header">
    <h3 class="name">
      {source.url ? (
        <a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>
      ) : (
        <span>{source.name}</span>
      )}
    </h3>
    <div class="badges">
      <span class="badge badge-region">{regionLabel}</span>
      <span class={`badge ${getQualityBadgeClass(source.source_quality)}`}>
        {getQualityLabel(source.source_quality)}
      </span>
      {source.enabled ? (
        <span class="badge badge-enabled">Enabled</span>
      ) : (
        <span class="badge badge-disabled">Disabled</span>
      )}
    </div>
  </div>

  <div class="details">
    <div class="detail-item">
      <strong>Capabilities:</strong> 
      <span>
        {capabilities.join(', ')}
      </span>
    </div>
    <div class="detail-item">
      <strong>Category:</strong> 
      <span>
        {source.category || 'unknown'}
      </span>
    </div>
    <div class="detail-item">
      <strong>Parser:</strong> 
      <span class={source.parser === 'manual_pending' ? 'badge badge-pending' : ''}>
        {source.parser || 'N/A'}
        {source.parser === 'manual_pending' && ' ⏳ (待开发/寻找入口)'}
      </span>
    </div>
    {source.notes && (
      <div class="detail-item notes">
        <strong>Notes:</strong> {source.notes}
      </div>
    )}
  </div>
</div>

<style>
  .source-card {
    border: 1px solid rgba(216, 182, 108, 0.4);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(238, 248, 255, 0.85) 100%);
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), border-color 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 16px rgba(47, 128, 183, 0.08), inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    position: relative;
    overflow: hidden;
  }
  .source-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, rgba(91, 188, 228, 0) 0%, rgba(216, 182, 108, 0.5) 50%, rgba(91, 188, 228, 0) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .source-card:hover {
    box-shadow: 0 4px 12px rgba(47, 128, 183, 0.12), 0 0 0 1px rgba(216, 182, 108, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    transform: translateY(-4px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(238, 248, 255, 0.7) 100%);
  }
  .source-card:hover::before {
    opacity: 1;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .name {
    margin: 0;
    font-size: 1.2rem;
    font-family: var(--font-serif, "Noto Serif SC", serif);
    font-weight: 600;
  }
  .name a {
    color: #17324d;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .name a:hover {
    color: #2f80b7;
    text-decoration: underline;
    text-decoration-color: rgba(216, 182, 108, 0.8);
  }
  .name span {
    color: #17324d;
  }
  .badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-weight: 500;
    font-family: var(--font-mono);
    border: 1px solid rgba(91, 188, 228, 0.3);
    box-shadow: 0 1px 2px rgba(47, 128, 183, 0.05);
  }
  .badge-region {
    background: rgba(255, 255, 255, 0.8);
    color: #2f80b7;
  }
  .badge-primary {
    background: linear-gradient(135deg, rgba(220, 252, 231, 0.8), rgba(255, 255, 255, 0.6));
    color: #166534;
    border-color: rgba(34, 197, 94, 0.4);
  }
  .badge-secondary {
    background: linear-gradient(135deg, rgba(254, 249, 195, 0.8), rgba(255, 255, 255, 0.6));
    color: #854d0e;
    border-color: rgba(234, 179, 8, 0.4);
  }
  .badge-community {
    background: linear-gradient(135deg, rgba(254, 226, 226, 0.8), rgba(255, 255, 255, 0.6));
    color: #991b1b;
    border-color: rgba(239, 68, 68, 0.4);
  }
  .badge-enabled {
    background: linear-gradient(135deg, rgba(224, 242, 254, 0.8), rgba(255, 255, 255, 0.6));
    color: #0369a1;
    border-color: rgba(14, 165, 233, 0.4);
  }
  .badge-disabled {
    background: rgba(241, 245, 249, 0.6);
    color: #64748b;
    opacity: 0.8;
    border-color: rgba(148, 163, 184, 0.4);
  }
  .badge-pending {
    background: linear-gradient(135deg, rgba(255, 251, 235, 0.8), rgba(255, 255, 255, 0.6));
    color: #b45309;
    border: 1px dashed rgba(216, 182, 108, 0.8);
    padding: 0.1rem 0.4rem;
  }
  .details {
    font-size: 0.9rem;
    color: #23384f;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .detail-item {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .detail-item strong {
    color: #17324d;
    font-weight: 600;
  }
  .detail-item span {
    font-family: var(--font-mono);
    color: #2f80b7;
  }
  .notes {
    margin-top: 0.5rem;
    padding-top: 0.8rem;
    border-top: 1px dashed rgba(91, 188, 228, 0.4);
    font-style: italic;
    color: #5b7c99;
  }
  .warning-text {
    color: #b45309;
    background: rgba(255, 251, 235, 0.8);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid rgba(216, 182, 108, 0.3);
  }
</style>
