---
export interface Props {
  sourceName: string;
  sourceUrl: string;
}

const { sourceName, sourceUrl } = Astro.props;
---
<a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="source-link">
  {sourceName}
  <svg class="external-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
    <polyline points="15 3 21 3 21 9"></polyline>
    <line x1="10" y1="14" x2="21" y2="3"></line>
  </svg>
</a>

<style>
  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .source-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .external-icon {
    opacity: 0.7;
  }
</style>
