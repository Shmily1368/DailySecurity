---
import type { DigestItem } from '../lib/data';
import RiskBadge from './RiskBadge.astro';
import TopicTag from './TopicTag.astro';
import SourceLink from './SourceLink.astro';
import ScoreBadge from './ScoreBadge.astro';

export interface Props {
  item: DigestItem;
}
const { item } = Astro.props;
const llm = item.llm_summary;
const tags = llm?.tags ?? item.topics ?? [];
const vendors = item.vendors ?? [];
const products = item.products ?? [];
---
<article class="card">
  <div class="header">
    <div class="meta-container">
      <div class="meta">
        <RiskBadge severity={item.severity} risk={item.risk} />
        <span class="type-badge">ADVISORY</span>
        <span class="date">{item.published_at.substring(0, 10)}</span>
      </div>
      <h3>
        <SourceLink sourceName={item.title} sourceUrl={item.source_url} />
      </h3>
    </div>
    <div class="score">
      <ScoreBadge recommendationScore={item.recommendation_score} confidence={item.confidence} />
    </div>
  </div>

  {llm?.refusal ? (
    <p class="refusal">该内容触发安全策略，已拒绝摘要，请看原链。</p>
  ) : (
    <div class="content">
      <div class="entities">
        {vendors.length > 0 && <span class="vendor"><svg viewBox="0 0 24 24" class="svg-icon"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h6"/></svg>{vendors.join(', ')}</span>}
        {products.length > 0 && <span class="product"><svg viewBox="0 0 24 24" class="svg-icon"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>{products.join(', ')}</span>}
      </div>

      <p class="summary">{llm.summary_zh}</p>
      
      <div class="highlights">
        {item.why_it_matters && (
          <p><strong>💡 风险点:</strong> {item.why_it_matters}</p>
        )}
        {item.recommended_action && (
          <p><strong>🎯 建议动作:</strong> {item.recommended_action}</p>
        )}
      </div>

      <div class="footer">
        <div class="tags">
          {tags.map(t => <TopicTag topic={t} />)}
        </div>
        <div class="source-info">
          来自 {item.source_name}
        </div>
      </div>
      
      {item.rank_reasons && item.rank_reasons.length > 0 && (
        <div class="rank-reasons">
          <strong>排序因子:</strong> <span>{item.rank_reasons.join(' | ')}</span>
        </div>
      )}
    </div>
  )}
</article>

<style>
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes rainbowBorder {
    to {
      --angle: 360deg;
    }
  }
  .card {
    border: 1px solid rgba(216, 182, 108, 0.4);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(238, 248, 255, 0.5) 100%);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 4px 16px rgba(47, 128, 183, 0.08), inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    position: relative;
    z-index: 1;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 13px; /* Slightly larger to cover the border */
    background: conic-gradient(
      from var(--angle),
      rgba(255, 0, 0, 0.7),
      rgba(255, 127, 0, 0.7),
      rgba(255, 255, 0, 0.7),
      rgba(0, 255, 0, 0.7),
      rgba(0, 0, 255, 0.7),
      rgba(75, 0, 130, 0.7),
      rgba(148, 0, 211, 0.7),
      rgba(255, 0, 0, 0.7)
    );
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 2px;
  }
  .card:hover {
    box-shadow: 0 8px 24px rgba(47, 128, 183, 0.15), inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    transform: translateY(-4px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(238, 248, 255, 0.7) 100%);
    border-color: transparent;
  }
  .card:hover::before {
    opacity: 1;
    animation: rainbowBorder 3s linear infinite;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 1.5rem;
  }
  .meta-container {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .type-badge {
    border: 1px solid rgba(216, 182, 108, 0.4);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    color: #d8b66c;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.8);
    font-weight: 600;
    letter-spacing: 0.05em;
    box-shadow: 0 1px 2px rgba(216, 182, 108, 0.1);
  }
  .date {
    color: #5bbce4;
    font-size: 0.85rem;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .date::before {
    content: '✦';
    color: rgba(216, 182, 108, 0.8);
    font-size: 0.7rem;
  }
  h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.4;
    font-family: var(--font-serif, "Noto Serif SC", serif);
    color: #17324d;
    font-weight: 600;
    word-break: break-word;
    overflow-wrap: break-word;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
  }
  .score {
    flex-shrink: 0;
  }
  .entities, .meta-row {
    margin-bottom: 1rem;
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: #23384f;
    flex-wrap: wrap;
  }
  .vendor, .product, .cve {
    background: rgba(255, 255, 255, 0.8);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(91, 188, 228, 0.4);
    box-shadow: 0 1px 3px rgba(47, 128, 183, 0.05);
    font-weight: 500;
    font-family: var(--font-mono);
    color: #2f80b7;
    display: inline-flex;
    align-items: center;
  }
  .svg-icon {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    margin-right: 4px;
    opacity: 0.8;
  }
  .summary {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
    color: #23384f;
    white-space: pre-wrap;
    word-break: break-word;
    text-align: justify;
  }
  .highlights {
    background: linear-gradient(to right, rgba(91, 188, 228, 0.08), rgba(255, 255, 255, 0.4));
    border-left: 4px solid #5bbce4;
    border-right: 1px solid rgba(91, 188, 228, 0.2);
    border-top: 1px solid rgba(91, 188, 228, 0.2);
    border-bottom: 1px solid rgba(91, 188, 228, 0.2);
    padding: 1rem 1.2rem;
    border-radius: 4px 8px 8px 4px;
    margin-bottom: 1.2rem;
    box-shadow: 0 2px 8px rgba(47, 128, 183, 0.03);
  }
  .highlights p {
    margin: 0.4rem 0;
    font-size: 0.9rem;
    color: #17324d;
    line-height: 1.6;
  }
  .highlights strong {
    color: #2f80b7;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(91, 188, 228, 0.2);
    padding-top: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1;
  }
  .source-info {
    font-size: 0.85rem;
    color: #5bbce4;
    font-weight: 500;
  }
  .rank-reasons {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: #2f80b7;
    background: rgba(238, 248, 255, 0.5);
    border: 1px solid rgba(91, 188, 228, 0.2);
    border-radius: 6px;
    padding: 0.6rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .rank-reasons::before {
    content: '✦';
    color: #d8b66c;
  }
  .rank-reasons strong {
    white-space: nowrap;
  }
  .refusal {
    color: #b91c1c;
    background: linear-gradient(to right, #fef2f2, #fff);
    padding: 1rem;
    border-radius: 8px;
    border-left: 4px solid #b91c1c;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      gap: 0.8rem;
    }
    .score {
      align-self: flex-start;
    }
    .card {
      padding: 1rem;
    }
  }
</style>
