---
import { formatPercent, severityColor } from '../lib/format';
import type { RiskSignal, Severity } from '../lib/data';

export interface Props {
  severity?: Severity;
  risk?: RiskSignal | null;
}

const { severity = 'info', risk } = Astro.props;
const epss = risk?.epss_score;
const kevListed = risk?.kev_listed;
const inTheWild = risk?.known_exploited || risk?.exploit_in_the_wild;
---
<div class="risk-badges">
  <span class="sev" style={`background:${severityColor(severity)}`}>
    {severity.toUpperCase()}
  </span>
  
  {epss != null && (
    <span class="epss">EPSS {formatPercent(epss, 0)}</span>
  )}
  
  {kevListed && <span class="kev-badge">KEV</span>}
  
  {inTheWild && <span class="itw-badge"><svg viewBox="0 0 24 24" class="svg-icon"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>在野利用</span>}
</div>

<style>
  .svg-icon {
    width: 12px;
    height: 12px;
    stroke: currentColor;
    stroke-width: 2.5;
    fill: none;
    vertical-align: text-bottom;
    margin-right: 3px;
  }
  .risk-badges {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .sev {
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
    box-shadow: 0 2px 6px rgba(0,0,0,0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }
  .epss {
    font-size: 0.75rem;
    color: #17324d;
    background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(238,248,255,0.6));
    border: 1px solid rgba(91, 188, 228, 0.4);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-weight: 600;
    box-shadow: 0 1px 3px rgba(47, 128, 183, 0.05);
  }
  .kev-badge {
    background: linear-gradient(135deg, #e11d48, #be123c);
    color: #fff;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    font-family: var(--font-mono);
    box-shadow: 0 2px 6px rgba(225, 29, 72, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .itw-badge {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #9f1239, #881337);
    color: #fff;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-mono);
    box-shadow: 0 2px 6px rgba(159, 18, 57, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(216, 182, 108, 0.5);
  }
</style>
