---
export interface Props {
  topic: string;
}

const { topic } = Astro.props;
// 这里简单处理下 URI 编码，因为 Astro 会做静态路径匹配
const href = `/topics/${encodeURIComponent(topic)}`;
---
<a href={import.meta.env.BASE_URL.replace(/\/$/, '') + href} class="topic-tag">
  #{topic}
</a>

<style>
  .topic-tag {
    font-size: 0.75rem;
    color: #2f80b7;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(91, 188, 228, 0.3);
    padding: 0.15rem 0.5rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(47, 128, 183, 0.05);
  }
  .topic-tag:hover {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(216, 182, 108, 0.5);
    color: #17324d;
    box-shadow: 0 2px 4px rgba(216, 182, 108, 0.15);
    transform: translateY(-1px);
  }
</style>
