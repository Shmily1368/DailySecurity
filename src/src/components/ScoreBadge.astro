---
import { formatPercent } from '../lib/format';

export interface Props {
  recommendationScore: number;
  confidence: number;
  label?: string;
}

const { recommendationScore, confidence, label = "推荐" } = Astro.props;

// 动态颜色: 推荐分数越高颜色越深
const getScoreColor = (score: number) => {
  if (score >= 10) return '#b91c1c'; // dark red
  if (score >= 6) return '#c2410c';  // orange
  if (score >= 3) return '#b45309';  // lighter orange
  return '#9ca3af'; // gray
};
const color = getScoreColor(recommendationScore);
---
<div class="score-badge" style={`border-color: ${color}40`}>
  <div class="score-value" style={`color: ${color}`}>
    <span class="label">{label}</span>
    <span class="val">{recommendationScore.toFixed(1)}</span>
  </div>
  <div class="conf" title="LLM 摘要置信度">
    Conf: {formatPercent(confidence, 0)}
  </div>
</div>

<style>
  .score-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(216, 182, 108, 0.4);
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(243, 216, 139, 0.1) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    min-width: 4.5rem;
    box-shadow: 0 4px 12px rgba(216, 182, 108, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .score-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(216, 182, 108, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  .score-value {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
    font-family: var(--font-serif, "Noto Serif SC", serif);
  }
  .label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #17324d;
    opacity: 0.85;
    margin-bottom: 0.1rem;
    font-family: var(--font-sans, system-ui, sans-serif);
  }
  .val {
    font-size: 1.25rem;
    font-weight: 700;
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.8);
  }
  .conf {
    font-size: 0.65rem;
    color: #23384f;
    margin-top: 0.3rem;
    border-top: 1px solid rgba(216, 182, 108, 0.3);
    padding-top: 0.3rem;
    width: 100%;
    text-align: center;
    font-family: var(--font-mono);
    opacity: 0.8;
  }
  @media (max-width: 768px) {
    .score-badge {
      min-width: 3.5rem;
      padding: 0.3rem 0.4rem;
    }
    .val {
      font-size: 1.1rem;
    }
  }
</style>
