# ================================
# Cyber Security Daily Radar - .gitignore
# ================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境变量 (绝对不要进 Git)
.env
.env.local
.env.*.local

# Node / Astro
node_modules/
dist/
.astro/
.DS_Store

# 构建产物
build/
out/

# IDE
.idea/
.vscode/
.trae/
*.swp
*.swo

# 日志
*.log

# 临时数据
data/tmp/

# 本仓库专用的 credential 文件 (做法 2 隔离, 严禁入 Git)
# 即便它在 .git/ 下理论上不会被跟踪, 这里再加一层保险
.git-credentials-local
