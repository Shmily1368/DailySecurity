# ================================
# Cyber Security Daily Radar - 环境变量示例
# 复制为 .env 后填入真实值；.env 不要进 Git
# ================================

# LLM 配置
# LLM_PROVIDER: openai | mock
LLM_PROVIDER=mock

# 开发期强制走 mock，不消耗 API 配额
# 1 = mock, 0 = 真实调用
LLM_MOCK=1

# 仅在 LLM_MOCK=0 时需要
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NVD (可选，填了可提高限速)
NVD_API_KEY=

# GitHub Advisory (v0.2 再用)
GITHUB_TOKEN=

# 归档保留天数
DATA_RETENTION_DAYS=365

# 跨日去重窗口 (天)
DUP_WINDOW_DAYS=14
